{
  "name": "highfive",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "1.0.0",
  "type": "module",
  "description": "High5 — an interactive, playful English learning assistant for Hebrew speakers. Web app supporting multiple AI providers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "content": "node scripts/generate-content.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "modeldispatcher-browser-agent": "^0.6.7",
    "modeldispatcher-react-ui": "^0.6.7",
    "@sentry/browser": "^10.74.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "fast-uri": "^3.1.8",
    "@vitest/mocker": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
