# Optional cloud sync (Google Sign-In + Firestore).
# Leave these unset to run in Local mode (data stays in the browser).
# Get these values from the Firebase console: Project settings → Your apps → Web app.
# These are safe to expose in the client; access is controlled by firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
