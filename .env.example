# Optional cloud sync (Google Sign-In + Firestore).
# Leave these unset to run in Local mode (progress stays in the browser only).
# When unset, isCloudConfigured() is false and the Firebase SDK is never loaded.
# Get values from Firebase console: Project settings → Your apps → Web app.
# These are public client identifiers; access is controlled by firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: daily "you haven't done today's missions" push reminder.
# Get this from Firebase console: Project settings → Cloud Messaging →
# Web Push certificates → generate a key pair.
VITE_FIREBASE_VAPID_KEY=

# The reminder job itself (api/mission-reminder.ts) is server-side and does
# NOT read this file — it needs FIREBASE_SERVICE_ACCOUNT and CRON_SECRET set
# as Vercel project environment variables instead. See README.md.

# Optional error monitoring (Sentry). Leave unset for console-only reporting.
# Create a free project at https://sentry.io and paste the browser DSN here.
# VITE_SENTRY_DSN=
