# Optional Google Drive sync. Leave unset to run in Local mode (progress stays
# in the browser only). The OAuth *Web* client ID is a public identifier, not
# a secret: it appears in every Google sign-in URL. Data goes to the learner's
# own Drive appDataFolder; no High5 server ever sees it. See README.md.
VITE_GOOGLE_CLIENT_ID=

# Optional daily "you haven't done today's missions" web-push reminder (FCM).
# Get these from Firebase console: Project settings → Your apps → Web app,
# and Cloud Messaging → Web Push certificates for the VAPID key. They are
# public client identifiers. Unset, the reminder option is hidden.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# The reminder functions (api/) are server-side and do NOT read this file —
# they need FIREBASE_SERVICE_ACCOUNT and CRON_SECRET set as Vercel project
# environment variables instead. See README.md.

# Optional error monitoring (Sentry). Leave unset for console-only reporting.
# Create a free project at https://sentry.io and paste the browser DSN here.
# VITE_SENTRY_DSN=
