rules_version = '2';

// Deny everything to clients. Learning data never reaches Firestore — it
// stays on the device and, optionally, in the learner's own Google Drive.
// The only collection left, reminders/{installId}, is read and written by the
// Vercel functions through the Admin SDK, which these rules do not govern.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
