[{"prompts":[{"text":"Everything is made of atoms.","translation":"הכול עשוי מאטומים."},{"text":"Please pay attention to the teacher.","translation":"בבקשה שימו לב למורה."},{"text":"The hotel has an attractive garden.","translation":"למלון יש גינה מושכת."},{"text":"Who is the author of this book?","translation":"מי הסופר של הספר הזה?"}]},{"prompts":[{"text":"The light turns on automatically.","translation":"האור נדלק מעצמו."},{"text":"She won an award for her drawing.","translation":"היא זכתה בפרס על הציור שלה."},{"text":"I slept badly last night.","translation":"ישנתי רע אתמול בלילה."},{"text":"We play badminton in the garden.","translation":"אנחנו משחקים בדמינטון בגינה."}]},{"prompts":[{"text":"We have a barbecue on Independence Day.","translation":"אנחנו עושים מנגל ביום העצמאות."},{"text":"Dad goes to the barber every month.","translation":"אבא הולך לספר כל חודש."},{"text":"I know some basic English words.","translation":"אני יודע כמה מילים בסיסיות באנגלית."},{"text":"Basically, the game is easy.","translation":"בעיקרון, המשחק קל."}]},{"prompts":[{"text":"We enjoyed the beauty of the Galilee.","translation":"נהנינו מהיופי של הגליל."},{"text":"This class is for beginners.","translation":"השיעור הזה מיועד למתחילים."},{"text":"The baby has a round belly.","translation":"לתינוק יש בטן עגולה."},{"text":"I'm tired. Besides, it's late.","translation":"אני עייף. חוץ מזה, מאוחר."}]},{"prompts":[{"text":"My sister has blonde hair.","translation":"לאחותי יש שיער בלונדיני."},{"text":"There was blood on his knee.","translation":"היה דם על הברך שלו."},{"text":"We play a board game every Friday night.","translation":"אנחנו משחקים משחק קופסה כל יום שישי בערב."},{"text":"You get bonus points for a correct answer.","translation":"מקבלים נקודות בונוס על תשובה נכונה."}]},{"prompts":[{"text":"Put the dictionary on the bookshelf.","translation":"תשים את המילון על מדף הספרים."},{"text":"My mom's boss is very nice.","translation":"הבוס של אמא שלי מאוד נחמד."},{"text":"Let's brainstorm ideas for the project.","translation":"בואו נעשה סיעור מוחות לרעיונות לפרויקט."},{"text":"The brakes on my bike don't work.","translation":"הבלמים באופניים שלי לא עובדים."}]},{"prompts":[{"text":"There is a cool breeze from the sea.","translation":"יש בריזה קרירה מהים."},{"text":"Our budget for the trip is small.","translation":"התקציב שלנו לטיול קטן."},{"text":"We need a new light bulb.","translation":"אנחנו צריכים נורה חדשה."},{"text":"The dog buries its bone in the garden.","translation":"הכלב קובר את העצם שלו בגינה."}]},{"prompts":[{"text":"The cat is hiding in the bush.","translation":"החתול מתחבא בשיח."},{"text":"My uncle is a businessman.","translation":"הדוד שלי איש עסקים."},{"text":"Her mother is a successful businesswoman.","translation":"אמא שלה אשת עסקים מצליחה."},{"text":"We eat lunch in the cafeteria.","translation":"אנחנו אוכלים צהריים בקפטריה."}]},{"prompts":[{"text":"The university campus is very big.","translation":"הקמפוס של האוניברסיטה מאוד גדול."},{"text":"Start a sentence with a capital letter.","translation":"תתחיל משפט באות גדולה."},{"text":"Yoni is the captain of our team.","translation":"יוני הוא הקפטן של הקבוצה שלנו."},{"text":"We visited an old castle.","translation":"ביקרנו בטירה עתיקה."}]},{"prompts":[{"text":"The pencil is ten centimeters long.","translation":"העיפרון באורך עשרה סנטימטרים."},{"text":"This house is from the last century.","translation":"הבית הזה מהמאה הקודמת."},{"text":"I eat cereal with milk.","translation":"אני אוכל דגני בוקר עם חלב."},{"text":"I will certainly come to your party.","translation":"אני בוודאי אבוא למסיבה שלך."}]},{"prompts":[{"text":"Our team won the championship.","translation":"הקבוצה שלנו זכתה באליפות."},{"text":"Read chapter three for homework.","translation":"תקראו את פרק שלוש לשיעורי הבית."},{"text":"Look at the chart on page six.","translation":"תסתכלו בטבלה בעמוד שש."},{"text":"I chat with my friends online.","translation":"אני מתכתב עם החברים שלי ברשת."}]},{"prompts":[{"text":"There was a chemical smell in the room.","translation":"היה ריח כימי בחדר."},{"text":"My grandfather taught me chess.","translation":"סבא שלי לימד אותי שחמט."},{"text":"He has a pain in his chest.","translation":"יש לו כאב בחזה."},{"text":"I had a happy childhood.","translation":"הייתה לי ילדות מאושרת."}]},{"prompts":[{"text":"He has a cut on his chin.","translation":"יש לו חתך בסנטר."},{"text":"You have a choice of two desserts.","translation":"יש לך בחירה בין שני קינוחים."},{"text":"She is an Israeli citizen.","translation":"היא אזרחית ישראלית."},{"text":"This is a classic movie.","translation":"זה סרט קלאסי."}]},{"prompts":[{"text":"The cleaner comes on Tuesday.","translation":"המנקה באה ביום שלישי."},{"text":"The instructions are clear.","translation":"ההוראות ברורות."},{"text":"Please speak clearly.","translation":"בבקשה תדבר בבירור."},{"text":"The clerk gave me a form.","translation":"הפקיד נתן לי טופס."}]},{"prompts":[{"text":"The clown made the children laugh.","translation":"הליצן הצחיק את הילדים."},{"text":"Can you give me a clue?","translation":"אתה יכול לתת לי רמז?"},{"text":"I found a coin on the floor.","translation":"מצאתי מטבע על הרצפה."},{"text":"She wears a colorful dress.","translation":"היא לובשת שמלה צבעונית."}]},{"prompts":[{"text":"I need a comb for my hair.","translation":"אני צריך מסרק לשיער."},{"text":"My brother reads comics every day.","translation":"אחי קורא קומיקס כל יום."},{"text":"We communicate by email.","translation":"אנחנו שומרים על קשר במייל."},{"text":"My father works for a big company.","translation":"אבא שלי עובד בחברה גדולה."}]},{"prompts":[{"text":"I want to make a complaint.","translation":"אני רוצה להגיש תלונה."},{"text":"Mozart was a famous composer.","translation":"מוצרט היה מלחין מפורסם."},{"text":"The car is in good condition.","translation":"המכונית במצב טוב."},{"text":"The test consists of ten questions.","translation":"המבחן מורכב מעשר שאלות."}]},{"prompts":[{"text":"Africa is a big continent.","translation":"אפריקה היא יבשת גדולה."},{"text":"The driver lost control of the car.","translation":"הנהג איבד שליטה על המכונית."},{"text":"She answered all the questions correctly.","translation":"היא ענתה נכון על כל השאלות."},{"text":"We spent the weekend in the countryside.","translation":"בילינו את סוף השבוע באזור הכפרי."}]},{"prompts":[{"text":"We play tennis on the school court.","translation":"אנחנו משחקים טניס במגרש של בית הספר."},{"text":"That's a crazy idea!","translation":"זה רעיון מטורף!"},{"text":"My sister is very creative.","translation":"אחותי מאוד יצירתית."},{"text":"Art class develops your creativity.","translation":"שיעור אמנות מפתח את היצירתיות שלך."}]},{"prompts":[{"text":"Stealing is a crime.","translation":"גניבה היא פשע."},{"text":"The queen wears a gold crown.","translation":"המלכה עונדת כתר זהב."},{"text":"My grandparents went on a cruise.","translation":"סבא וסבתא שלי יצאו לשיט."},{"text":"Lighting candles is a Hanukkah custom.","translation":"הדלקת נרות היא מנהג של חנוכה."}]},{"prompts":[{"text":"Exercise is part of my daily routine.","translation":"פעילות גופנית היא חלק מהשגרה היומית שלי."},{"text":"The dam holds the water of the river.","translation":"הסכר עוצר את מי הנהר."},{"text":"She wants to be a dancer.","translation":"היא רוצה להיות רקדנית."},{"text":"The sign says \"Danger! Keep out!\"","translation":"בשלט כתוב \"סכנה! הכניסה אסורה!\""}]},{"prompts":[{"text":"The pool is very deep here.","translation":"הבריכה עמוקה מאוד כאן."},{"text":"Breathe deeply and relax.","translation":"תנשום עמוק ותירגע."},{"text":"It is thirty degrees today.","translation":"היום שלושים מעלות."},{"text":"We bought clothes at the department store.","translation":"קנינו בגדים בחנות הכלבו."}]},{"prompts":[{"text":"The storm destroyed many trees.","translation":"הסערה הרסה הרבה עצים."},{"text":"Tell me every detail of the trip.","translation":"ספר לי כל פרט מהטיול."},{"text":"Her ring has a small diamond.","translation":"בטבעת שלה יש יהלום קטן."},{"text":"Fruit is part of a healthy diet.","translation":"פירות הם חלק מתזונה בריאה."}]},{"prompts":[{"text":"He has difficulty reading small letters.","translation":"קשה לו לקרוא אותיות קטנות."},{"text":"I took the photos with a digital camera.","translation":"צילמתי את התמונות במצלמה דיגיטלית."},{"text":"We saw dinosaur bones at the museum.","translation":"ראינו עצמות דינוזאור במוזיאון."},{"text":"Is there a direct flight to London?","translation":"יש טיסה ישירה ללונדון?"}]},{"prompts":[{"text":"The director of the movie is famous.","translation":"הבמאי של הסרט מפורסם."},{"text":"I disagree with you.","translation":"אני לא מסכים איתך."},{"text":"The sun disappeared behind the clouds.","translation":"השמש נעלמה מאחורי העננים."},{"text":"I was disappointed with my grade.","translation":"הייתי מאוכזב מהציון שלי."}]},{"prompts":[{"text":"We had a discussion about the environment.","translation":"ניהלנו דיון על איכות הסביבה."},{"text":"I dislike cold weather.","translation":"אני לא אוהב מזג אוויר קר."},{"text":"There is a nice display in the shop window.","translation":"יש תצוגה יפה בחלון הראווה."},{"text":"Please don't disturb me, I'm studying.","translation":"בבקשה אל תפריע לי, אני לומד."}]},{"prompts":[{"text":"I feel dizzy after the ride.","translation":"אני מרגיש סחרחורת אחרי המתקן."},{"text":"I'd like a double room, please.","translation":"אני רוצה חדר זוגי, בבקשה."},{"text":"The kitchen is downstairs.","translation":"המטבח למטה."},{"text":"Let's go downtown on Saturday.","translation":"בוא ניסע למרכז העיר בשבת."}]},{"prompts":[{"text":"My brother just got his driver's license.","translation":"אחי בדיוק קיבל רישיון נהיגה."},{"text":"There is dust on the shelf.","translation":"יש אבק על המדף."},{"text":"The Earth goes around the sun.","translation":"כדור הארץ מסתובב סביב השמש."},{"text":"There was a small earthquake last night.","translation":"הייתה רעידת אדמה קטנה אתמול בלילה."}]},{"prompts":[{"text":"The sun rises in the east.","translation":"השמש זורחת במזרח."},{"text":"She is the editor of the school newspaper.","translation":"היא העורכת של עיתון בית הספר."},{"text":"Education is important for every child.","translation":"חינוך חשוב לכל ילד."},{"text":"This is an educational game.","translation":"זה משחק חינוכי."}]},{"prompts":[{"text":"My dad has an electric car.","translation":"לאבא שלי יש מכונית חשמלית."},{"text":"Take the elevator to the fifth floor.","translation":"תעלה במעלית לקומה החמישית."},{"text":"This shop is closed, let's go elsewhere.","translation":"החנות הזאת סגורה, בוא נלך למקום אחר."},{"text":"Falling on stage was embarrassing.","translation":"ליפול על הבמה היה מביך."}]},{"prompts":[{"text":"Tigers are endangered animals.","translation":"טיגריסים הם בעלי חיים בסכנת הכחדה."},{"text":"The children are very energetic today.","translation":"הילדים מלאי אנרגיה היום."},{"text":"An elephant is an enormous animal.","translation":"פיל הוא חיה ענקית."},{"text":"TV is my favorite entertainment.","translation":"טלוויזיה היא הבידור האהוב עליי."}]},{"prompts":[{"text":"I watched the last episode yesterday.","translation":"צפיתי בפרק האחרון אתמול."},{"text":"There is an error in this sentence.","translation":"יש שגיאה במשפט הזה."},{"text":"Take the escalator to the second floor.","translation":"תעלה במדרגות הנעות לקומה השנייה."},{"text":"I love fruit, especially mango.","translation":"אני אוהב פירות, במיוחד מנגו."}]},{"prompts":[{"text":"He works even on Saturdays.","translation":"הוא עובד אפילו בשבתות."},{"text":"Have you ever been to Eilat?","translation":"היית פעם באילת?"},{"text":"The train leaves at exactly six.","translation":"הרכבת יוצאת בשש בדיוק."},{"text":"I have an English exam on Sunday.","translation":"יש לי בחינה באנגלית ביום ראשון."}]},{"prompts":[{"text":"Do you think aliens exist?","translation":"אתה חושב שחייזרים קיימים?"},{"text":"He is an expert on birds.","translation":"הוא מומחה לציפורים."},{"text":"Thank you for the clear explanation.","translation":"תודה על ההסבר הברור."},{"text":"\"Break a leg\" is an English expression.","translation":"\"Break a leg\" הוא ביטוי באנגלית."}]},{"prompts":[{"text":"It is extremely hot today.","translation":"חם מאוד מאוד היום."},{"text":"I deleted the file by accident.","translation":"מחקתי את הקובץ בטעות."},{"text":"I didn't do it on purpose.","translation":"לא עשיתי את זה בכוונה."},{"text":"You are supposed to finish your homework before dinner.","translation":"אתה אמור לסיים את שיעורי הבית לפני ארוחת הערב."}]},{"prompts":[{"text":"Are you willing to help me organize the party tomorrow?","translation":"אתה מוכן לעזור לי לארגן את המסיבה מחר?"},{"text":"The ticket costs a lot, but the exhibition is worth seeing.","translation":"הכרטיס עולה הרבה, אבל שווה לראות את התערוכה."},{"text":"Old cars often break down on long trips.","translation":"מכוניות ישנות מתקלקלות לעתים קרובות בנסיעות ארוכות."},{"text":"I can't stand loud music in the morning.","translation":"אני לא סובל מוזיקה רועשת בבוקר."}]},{"prompts":[{"text":"The doctors will carry out the test today.","translation":"הרופאים יבצעו את הבדיקה היום."},{"text":"He was carrying a heavy case. It was an interesting case.","translation":"הוא סחב מזוודה כבדה. זה היה מקרה מעניין."},{"text":"We traveled to the match together in a comfortable coach.","translation":"נסענו למשחק יחד באוטובוס נוח."},{"text":"The teacher needs two days to correct all the exams.","translation":"המורה צריכה יומיים כדי לבדוק את כל המבחנים."}]},{"prompts":[{"text":"Customer service has to deal with many complaints every day.","translation":"שירות הלקוחות צריך לטפל בהרבה תלונות בכל יום."},{"text":"I might come tomorrow; it depends on the weather.","translation":"אולי אבוא מחר; זה תלוי במזג האוויר."},{"text":"Every employee gets training.","translation":"כל עובד מקבל הכשרה."},{"text":"My employer gave me a day off.","translation":"המעסיק שלי נתן לי יום חופש."}]},{"prompts":[{"text":"It is time to get rid of these old broken shoes.","translation":"הגיע הזמן להיפטר מהנעליים הישנות והקרועות האלה."},{"text":"Who is in charge of the school festival this year?","translation":"מי אחראי על פסטיבל בית הספר השנה?"},{"text":"My sister will look after the dog this week.","translation":"אחותי תשמור על הכלב השבוע."},{"text":"I'm looking forward to my vacation.","translation":"אני מחכה בכיליון עיניים לחופשה שלי."}]},{"prompts":[{"text":"Never mind the rain, I don't mind walking.","translation":"לא משנה הגשם, לא אכפת לי ללכת."},{"text":"The students tried to play a trick on their friend.","translation":"התלמידים ניסו לעשות מתיחה לחבר שלהם."},{"text":"We had to postpone the concert because of the storm.","translation":"נאלצנו לדחות את ההופעה בגלל הסערה."},{"text":"Can you show me how to pronounce this word?","translation":"אתה יכול להראות לי איך מבטאים את המילה הזאת?"}]},{"prompts":[{"text":"We waited for quite a while, and we talked quite a bit.","translation":"חיכינו זמן רב, ודיברנו די הרבה."},{"text":"They travel abroad every summer.","translation":"הם נוסעים לחו\"ל כל קיץ."},{"text":"The weather is nice today.","translation":"מזג האוויר נעים היום."},{"text":"This restaurant is too expensive.","translation":"המסעדה הזו יקרה מדי."}]},{"prompts":[{"text":"These two cars are very different.","translation":"שתי המכוניות האלה מאוד שונות."},{"text":"I stayed home because I was tired.","translation":"נשארתי בבית כי הייתי עייף."},{"text":"We have enough food for everyone.","translation":"יש לנו מספיק אוכל לכולם."},{"text":"She decided to study medicine.","translation":"היא החליטה ללמוד רפואה."}]},{"prompts":[{"text":"He saved a lot of money.","translation":"הוא חסך הרבה כסף."},{"text":"I woke up early today.","translation":"התעוררתי מוקדם היום."},{"text":"Italy is a beautiful country.","translation":"איטליה היא מדינה יפה."},{"text":"I want to learn English.","translation":"אני רוצה ללמוד אנגלית."}]},{"prompts":[{"text":"We solved the problem together.","translation":"פתרנו את הבעיה יחד."},{"text":"Can you help me, please?","translation":"אתה יכול לעזור לי, בבקשה?"},{"text":"This is a quiet place.","translation":"זה מקום שקט."},{"text":"The fi