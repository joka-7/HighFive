[{"title":"My Morning (הבוקר שלי)","text":"I wake up at seven. I drink water and eat bread with cheese. Then I go to work by bus. The bus is often full, but I like to look out the window.","glossary":[{"word":"wake up","partOfSpeech":"verb","definition":"להתעורר משינה","example":"I wake up early.","translation":"להתעורר"},{"word":"bus","partOfSpeech":"noun","definition":"כלי תחבורה ציבורי גדול","example":"The bus is full.","translation":"אוטובוס"},{"word":"full","partOfSpeech":"adjective","definition":"מלא, אין מקום פנוי","example":"The cup is full.","translation":"מלא"}],"questions":[{"question":"When does the writer wake up?","options":["At six","At seven","At eight","At nine"],"correctIndex":1,"explanation":"כתוב 'I wake up at seven'."},{"question":"How does the writer go to work?","options":["By car","By bike","By bus","On foot"],"correctIndex":2,"explanation":"כתוב 'I go to work by bus'."}]},{"title":"My Friend Lia (החברה שלי ליה)","text":"Lia is my friend. She lives near my house. We go to school together every day. After school we play in the park and then we do our homework.","glossary":[{"word":"near","partOfSpeech":"preposition","definition":"קרוב ל-","example":"I live near the sea.","translation":"ליד/קרוב"},{"word":"together","partOfSpeech":"adverb","definition":"ביחד, עם מישהו","example":"We work together.","translation":"ביחד"},{"word":"homework","partOfSpeech":"noun","definition":"עבודה שעושים בבית אחרי בית הספר","example":"I do my homework.","translation":"שיעורי בית"}],"questions":[{"question":"Where does Lia live?","options":["Far away","Near the writer's house","In another city","At school"],"correctIndex":1,"explanation":"כתוב 'She lives near my house'."},{"question":"What do they do after school?","options":["Sleep","Play in the park","Go to work","Watch TV"],"correctIndex":1,"explanation":"כתוב 'we play in the park'."}]},{"title":"The Cat (החתול)","text":"I have a small cat. Her name is Mimi. She is black and white. Mimi sleeps all day and plays at night. I give her food in the morning and in the evening.","glossary":[{"word":"small","partOfSpeech":"adjective","definition":"קטן בגודלו","example":"A small cat.","translation":"קטן"},{"word":"sleep","partOfSpeech":"verb","definition":"לנוח עם עיניים עצומות","example":"I sleep at night.","translation":"לישון"},{"word":"evening","partOfSpeech":"noun","definition":"החלק האחרון של היום","example":"Good evening.","translation":"ערב"}],"questions":[{"question":"What colour is Mimi?","options":["All black","Black and white","Brown","Grey"],"correctIndex":1,"explanation":"כתוב 'She is black and white'."},{"question":"When does Mimi play?","options":["In the morning","At noon","At night","Never"],"correctIndex":2,"explanation":"כתוב 'plays at night'."}]},{"title":"At the Shop (בחנות)","text":"On Sunday I go to the shop. I buy milk, eggs and apples. The shop is near my house. The woman at the shop is very nice and she always says hello.","glossary":[{"word":"buy","partOfSpeech":"verb","definition":"לתת כסף ולקבל מוצר","example":"I buy bread.","translation":"לקנות"},{"word":"shop","partOfSpeech":"noun","definition":"מקום שבו קונים דברים","example":"The shop is open.","translation":"חנות"},{"word":"nice","partOfSpeech":"adjective","definition":"נחמד, טוב","example":"She is nice.","translation":"נחמד"}],"questions":[{"question":"What does the writer buy?","options":["Milk, eggs and apples","Bread and cheese","Only milk","Fish"],"correctIndex":0,"explanation":"כתוב 'milk, eggs and apples'."},{"question":"How is the woman at the shop?","options":["Tired","Angry","Nice","Busy"],"correctIndex":2,"explanation":"כתוב 'is very nice'."}]},{"title":"My Day Off (יום החופש שלי)","text":"Today I do not work. I stay at home. In the morning I read a book. In the afternoon my brother comes and we cook lunch. It is a good day.","glossary":[{"word":"stay","partOfSpeech":"verb","definition":"להישאר במקום","example":"I stay at home.","translation":"להישאר"},{"word":"cook","partOfSpeech":"verb","definition":"להכין אוכל","example":"We cook dinner.","translation":"לבשל"},{"word":"brother","partOfSpeech":"noun","definition":"אח","example":"My brother is tall.","translation":"אח"}],"questions":[{"question":"Where is the writer today?","options":["At work","At home","At school","At the park"],"correctIndex":1,"explanation":"כתוב 'I stay at home'."},{"question":"Who comes in the afternoon?","options":["A friend","The teacher","The brother","Nobody"],"correctIndex":2,"explanation":"כתוב 'my brother comes'."}]},{"title":"At the Park (בפארק)","text":"On Saturday we go to the park. My father plays football with me. My mother sits and reads a book. Later we eat sandwiches on the grass. I like Saturdays.","glossary":[{"word":"park","partOfSpeech":"noun","definition":"שטח ירוק ציבורי","example":"We play in the park.","translation":"פארק"},{"word":"football","partOfSpeech":"noun","definition":"משחק כדור פופולרי","example":"I like football.","translation":"כדורגל"},{"word":"grass","partOfSpeech":"noun","definition":"הצמח הירוק שעל הקרקע","example":"Sit on the grass.","translation":"דשא"}],"questions":[{"question":"What does the father do at the park?","options":["Reads","Plays football","Sleeps","Cooks"],"correctIndex":1,"explanation":"'plays football with me'."},{"question":"Where do they eat?","options":["At home","On the grass","In a café","On a bench"],"correctIndex":1,"explanation":"'eat sandwiches on the grass'."}]},{"title":"My School Bag (התיק שלי)","text":"This is my school bag. It is blue. Inside I have three books, two pens and an apple. The bag is heavy, but I carry it every day.","glossary":[{"word":"bag","partOfSpeech":"noun","definition":"תיק לנשיאת דברים","example":"A school bag.","translation":"תיק"},{"word":"heavy","partOfSpeech":"adjective","definition":"כבד, קשה לשאת","example":"A heavy box.","translation":"כבד"},{"word":"carry","partOfSpeech":"verb","definition":"לשאת משהו","example":"I carry the bag.","translation":"לשאת"}],"questions":[{"question":"What colour is the bag?","options":["Red","Blue","Green","Black"],"correctIndex":1,"explanation":"'It is blue'."},{"question":"What fruit is in the bag?","options":["A banana","An apple","An orange","A pear"],"correctIndex":1,"explanation":"'an apple'."}]},{"title":"Rainy Day (יום גשום)","text":"Today it is raining. I cannot play outside. So I stay at home and draw pictures. My sister helps me. We have fun together, even on a rainy day.","glossary":[{"word":"raining","partOfSpeech":"verb","definition":"כשיורד גשם","example":"It is raining.","translation":"יורד גשם"},{"word":"outside","partOfSpeech":"adverb","definition":"מחוץ לבית","example":"Play outside.","translation":"בחוץ"},{"word":"draw","partOfSpeech":"verb","definition":"ליצור תמונה בעיפרון","example":"I draw a cat.","translation":"לצייר"}],"questions":[{"question":"Why can't the child play outside?","options":["It is night","It is raining","It is cold","It is late"],"correctIndex":1,"explanation":"'it is raining'."},{"question":"What do they do at home?","options":["Sleep","Draw pictures","Cook","Read"],"correctIndex":1,"explanation":"'draw pictures'."}]},{"title":"The Birthday (יום ההולדת)","text":"Today is my birthday. I am ten years old. My friends come to my house. We eat cake and play games. I am very happy.","glossary":[{"word":"birthday","partOfSpeech":"noun","definition":"יום ההולדת של אדם","example":"Happy birthday!","translation":"יום הולדת"},{"word":"cake","partOfSpeech":"noun","definition":"עוגה מתוקה","example":"A chocolate cake.","translation":"עוגה"},{"word":"happy","partOfSpeech":"adjective","definition":"שמח","example":"I am happy.","translation":"שמח"}],"questions":[{"question":"How old is the writer?","options":["Eight","Nine","Ten","Eleven"],"correctIndex":2,"explanation":"'I am ten years old'."},{"question":"What do they eat?","options":["Bread","Cake","Fruit","Soup"],"correctIndex":1,"explanation":"'We eat cake'."}]},{"title":"My Favourite Food (האוכל האהוב עליי)","text":"My favourite food is pizza. I eat it on Friday with my family. We make it at home. I put cheese and tomato on top. It is delicious!","glossary":[{"word":"favourite","partOfSpeech":"adjective","definition":"האהוב ביותר","example":"My favourite song.","translation":"אהוב/מועדף"},{"word":"cheese","partOfSpeech":"noun","definition":"מאכל מחלב","example":"I like cheese.","translation":"גבינה"},{"word":"top","partOfSpeech":"noun","definition":"החלק העליון","example":"On top.","translation":"למעלה/חלק עליון"}],"questions":[{"question":"What is the writer's favourite food?","options":["Pasta","Pizza","Rice","Soup"],"correctIndex":1,"explanation":"'My favourite food is pizza'."},{"question":"When do they eat it?","options":["Monday","Friday","Sunday","Every day"],"correctIndex":1,"explanation":"'on Friday'."}]},{"title":"Going to the Zoo (ביקור בגן החיות)","text":"On Sunday we go to the zoo. I see lions, monkeys and a big elephant. The monkeys are funny. My little brother likes the birds. We have a great day.","glossary":[{"word":"zoo","partOfSpeech":"noun","definition":"מקום עם חיות לצפייה","example":"We go to the zoo.","translation":"גן חיות"},{"word":"elephant","partOfSpeech":"noun","definition":"חיה גדולה מאוד","example":"A grey elephant.","translation":"פיל"},{"word":"funny","partOfSpeech":"adjective","definition":"מצחיק","example":"A funny story.","translation":"מצחיק"}],"questions":[{"question":"What animal does the brother like?","options":["Lions","Monkeys","Birds","Elephants"],"correctIndex":2,"explanation":"'my little brother likes the birds'."},{"question":"Which animal is described as big?","options":["The monkey","The elephant","The bird","The lion"],"correctIndex":1,"explanation":"'a big elephant'."}]},{"title":"At the Doctor (אצל הרופא)","text":"I do not feel well. My head hurts and I am hot. My mother takes me to the doctor. The doctor says I must rest and drink water. Tomorrow I will feel better.","glossary":[{"word":"hurts","partOfSpeech":"verb","definition":"כואב","example":"My leg hurts.","translation":"כואב"},{"word":"doctor","partOfSpeech":"noun","definition":"מי שמטפל בחולים","example":"See a doctor.","translation":"רופא"},{"word":"rest","partOfSpeech":"verb","definition":"לנוח","example":"You must rest.","translation":"לנוח"}],"questions":[{"question":"What is the problem?","options":["A broken leg","A headache and fever","A cold foot","Nothing"],"correctIndex":1,"explanation":"'My head hurts and I am hot'."},{"question":"What must the child do?","options":["Run","Rest and drink water","Eat cake","Go to school"],"correctIndex":1,"explanation":"'rest and drink water'."}]},{"title":"My Room (החדר שלי)","text":"This is my room. There is a bed, a desk and a small window. On the desk I have books and a lamp. I like my room because it is quiet.","glossary":[{"word":"desk","partOfSpeech":"noun","definition":"שולחן כתיבה","example":"Sit at the desk.","translation":"שולחן כתיבה"},{"word":"lamp","partOfSpeech":"noun","definition":"מנורה","example":"Turn on the lamp.","translation":"מנורה"},{"word":"quiet","partOfSpeech":"adjective","definition":"שקט","example":"A quiet room.","translation":"שקט"}],"questions":[{"question":"What is on the desk?","options":["A bed","Books and a lamp","A window","A door"],"correctIndex":1,"explanation":"'books and a lamp'."},{"question":"Why does the writer like the room?","options":["It is big","It is quiet","It is new","It is warm"],"correctIndex":1,"explanation":"'because it is quiet'."}]},{"title":"In the Kitchen (במטבח)","text":"My father cooks dinner. He uses a big pot. I help him. I wash the tomatoes and put them on a plate. The kitchen smells very good.","glossary":[{"word":"pot","partOfSpeech":"noun","definition":"כלי בישול עמוק","example":"A big pot.","translation":"סיר"},{"word":"wash","partOfSpeech":"verb","definition":"לנקות במים","example":"Wash the fruit.","translation":"לשטוף/לרחוץ"},{"word":"smell","partOfSpeech":"verb","definition":"להריח","example":"It smells good.","translation":"להריח"}],"questions":[{"question":"Who cooks dinner?","options":["The mother","The father","The child","A friend"],"correctIndex":1,"explanation":"'My father cooks dinner'."},{"question":"What does the child wash?","options":["The plates","The tomatoes","The pot","The floor"],"correctIndex":1,"explanation":"'I wash the tomatoes'."}]},{"title":"A Walk in Winter (טיול בחורף)","text":"It is winter. There is snow on the street. I wear a warm coat and a hat. My friend and I make a snowman. Then we drink hot tea at home.","glossary":[{"word":"winter","partOfSpeech":"noun","definition":"העונה הקרה","example":"Cold winter.","translation":"חורף"},{"word":"warm","partOfSpeech":"adjective","definition":"חמים","example":"A warm coat.","translation":"חמים"},{"word":"snowman","partOfSpeech":"noun","definition":"בובת שלג","example":"Build a snowman.","translation":"איש שלג"}],"questions":[{"question":"What is the weather?","options":["Hot","Snowy","Rainy","Windy"],"correctIndex":1,"explanation":"'There is snow on the street'."},{"question":"What do they do?","options":["Swim","Make a snowman","Run","Sleep"],"correctIndex":1,"explanation":"'make a snowman'."}]},{"title":"The Bus to School (האוטובוס לבית הספר)","text":"Every morning I take the bus to school. The bus comes at eight. My friend Noa sits next to me. We talk and look out the window. School starts at half past eight.","glossary":[{"word":"morning","partOfSpeech":"noun","definition":"תחילת היום","example":"Every morning.","translation":"בוקר"},{"word":"next to","partOfSpeech":"phrase","definition":"ליד","example":"Sit next to me.","translation":"ליד/לצד"},{"word":"start","partOfSpeech":"verb","definition":"להתחיל","example":"School starts.","translation":"מתחיל"}],"questions":[{"question":"When does the bus come?","options":["At seven","At eight","At nine","At ten"],"correctIndex":1,"explanation":"'The bus comes at eight'."},{"question":"Who sits next to the writer?","options":["The teacher","Noa","The driver","No one"],"correctIndex":1,"explanation":"'My friend Noa sits next to me'."}]},{"title":"A Rainy Afternoon (אחר צהריים גשום)","text":"It is raining today. I cannot go to the park. So I stay home with my brother. We play a game and then we draw. Later, Mum makes hot soup. It is a nice day after all.","glossary":[{"word":"raining","partOfSpeech":"verb","definition":"יורד גשם","example":"It is raining.","translation":"יורד גשם"},{"word":"stay","partOfSpeech":"verb","definition":"להישאר","example":"Stay home.","translation":"להישאר"},{"word":"soup","partOfSpeech":"noun","definition":"מרק","example":"Hot soup.","translation":"מרק"}],"questions":[{"question":"Why does the child stay home?","options":["It is hot","It is raining","It is late","It is a holiday"],"correctIndex":1,"explanation":"'It is raining today'."},{"question":"What does Mum make?","options":["Cake","Hot soup","Bread","Tea"],"correctIndex":1,"explanation":"'Mum makes hot soup'."}]},{"title":"My Favourite Toy (הצעצוע האהוב עליי)","text":"I have a brown teddy bear. His name is Pip. He sleeps in my bed every night. When I am sad, I hug him. Pip is small, but he is my best friend.","glossary":[{"word":"teddy bear","partOfSpeech":"noun","definition":"דובון צעצוע","example":"A brown teddy bear.","translation":"דובון"},{"word":"hug","partOfSpeech":"verb","definition":"לחבק","example":"I hug him.","translation":"לחבק"},{"word":"best","partOfSpeech":"adjective","definition":"הכי טוב","example":"My best friend.","translation":"הכי טוב"}],"questions":[{"question":"What is the toy's name?","options":["Max","Pip","Sam","Ben"],"correctIndex":1,"explanation":"'His name is Pip'."},{"question":"What does the child do when sad?","options":["Cry","Hug Pip","Sleep","Run"],"correctIndex":1,"explanation":"'When I am sad, I hug him'."}]},{"title":"At the Zoo (בגן החיות)","text":"Today we go to the zoo. I see a big lion and two monkeys. The monkeys jump and play. My little sister likes the elephant best. We eat lunch near the ducks.","glossary":[{"word":"zoo","partOfSpeech":"noun","definition":"גן חיות","example":"Go to the zoo.","translation":"גן חיות"},{"word":"lion","partOfSpeech":"noun","definition":"אריה","example":"A big lion.","translation":"אריה"},{"word":"elephant","partOfSpeech":"noun","definition":"פיל","example":"The big elephant.","translation":"פיל"}],"questions":[{"question":"How many monkeys does the child see?","options":["One","Two","Three","Four"],"correctIndex":1,"explanation":"'two monkeys'."},{"question":"Which animal does the sister like best?","options":["The lion","The elephant","The duck","The monkey"],"correctIndex":1,"explanation":"'likes the elephant best'."}]},{"title":"Helping Mum Cook (עוזר לאמא לבשל)","text":"I help my mum in the kitchen. I wash the carrots and she cuts them. We make a big pot of soup. It smells very good. After dinner, I help to wash the plates.","glossary":[{"word":"kitchen","partOfSpeech":"noun","definition":"מטבח","example":"In the kitchen.","translation":"מטבח"},{"word":"wash","partOfSpeech":"verb","definition":"לשטוף","example":"Wash the carrots.","translation":"לשטוף"},{"word":"soup","partOfSpeech":"noun","definition":"מרק","example":"A pot of soup.","translation":"מרק"}],"questions":[{"question":"What does the child wash first?","options":["The plates","The carrots","The pot","The table"],"correctIndex":1,"explanation":"'I wash the carrots'."},{"question":"What do they make?","options":["Cake","Soup","Bread","Salad"],"correctIndex":1,"explanation":"'a big pot of soup'."}]},{"title":"A Snowy Day (יום מושלג)","text":"It snowed last night. Everything is white! My brother and I put on warm coats and boots. We make a snowman with a carrot nose. Then we drink hot tea inside.","glossary":[{"word":"snow","partOfSpeech":"verb","definition":"לרדת שלג","example":"It snowed.","translation":"לרדת שלג"},{"word":"boots","partOfSpeech":"noun","definition":"מגפיים","example":"Warm boots.","translation":"מגפיים"},{"word":"snowman","partOfSpeech":"noun","definition":"איש שלג","example":"Make a snowman.","translation":"איש שלג"}],"questions":[{"question":"What colour is everything?","options":["Green","White","Blue","Grey"],"correctIndex":1,"explanation":"'Everything is white'."},{"question":"What do they use for the nose?","options":["A stone","A carrot","A stick","A button"],"correctIndex":1,"explanation":"'a snowman with a carrot nose'."}]},{"title":"My New Shoes (הנעליים החדשות שלי)","text":"Mum bought me new shoes today. They are blue with white laces. They fit my feet just right. I want to run and jump in them. I will wear them to school tomorrow.","glossary":[{"word":"shoes","partOfSpeech":"noun","definition":"נעליים","example":"New shoes.","translation":"נעליים"},{"word":"laces","partOfSpeech":"noun","definition":"שרוכים","example":"White laces.","translation":"שרוכים"},{"word":"fit","partOfSpeech":"verb","definition":"להתאים (במידה)","example":"They fit me.","translation":"להתאים"}],"questions":[{"question":"What colour are the shoes?","options":["Red","Blue","Black","Green"],"correctIndex":1,"explanation":"'They are blue with white laces'."},{"question":"When will the child wear them?","options":["Today","Tomorrow to school","Never","On Sunday"],"correctIndex":1,"explanation":"'wear them to school tomorrow'."}]},{"title":"Feeding the Cat (מאכיל את החתול)","text":"We have a grey cat called Misha. Every morning I give her food and clean water. She rubs my leg and says 'meow'. After she eats, she sleeps in the sun by the window.","glossary":[{"word":"grey","partOfSpeech":"adjective","definition":"אפור","example":"A grey cat.","translation":"אפור"},{"word":"feed","partOfSpeech":"verb","definition":"להאכיל","example":"I feed the cat.","translation":"להאכיל"},{"word":"clean","partOfSpeech":"adjective","definition":"נקי","example":"Clean water.","translation":"נקי"}],"questions":[{"question":"What is the cat's name?","options":["Misha","Max","Lily","Spot"],"correctIndex":0,"explanation":"'a grey cat called Misha'."},{"question":"Where does the cat sleep?","options":["On the bed","In the sun by the window","On the floor","Outside"],"correctIndex":1,"explanation":"'she sleeps in the sun by the window'."}]},{"title":"A Day at the Beach (יום בים)","text":"On Sunday we went to the beach. The sun was hot and the water was cool. I made a big castle in the sand. My dad and I swam together. Then we ate ice cream.","glossary":[{"word":"beach","partOfSpeech":"noun","definition":"חוף ים","example":"Go to the beach.","translation":"חוף ים"},{"word":"sand","partOfSpeech":"noun","definition":"חול","example":"Castle in the sand.","translation":"חול"},{"word":"swam","partOfSpeech":"verb","definition":"שחה","example":"We swam.","translation":"שחה"}],"questions":[{"question":"What day did they go?","options":["Saturday","Sunday","Monday","Friday"],"correctIndex":1,"explanation":"'On Sunday we went to the beach'."},{"question":"What did the child make in the sand?","options":["A hole","A big castle","A boat","A road"],"correctIndex":1,"explanation":"'I made a big castle in the sand'."}]},{"title":"My Grandpa's Garden (הגינה של סבא)","text":"My grandpa has a small garden. He grows tomatoes, carrots and flowers. I help him water the plants. The tomatoes are red and sweet. We eat them at dinner.","glossary":[{"word":"grow","partOfSpeech":"verb","definition":"לגדל, לצמוח","example":"He grows tomatoes.","translation":"לגדל/לצמוח"},{"word":"water","partOfSpeech":"verb","definition":"להשקות","example":"Water the plants.","translation":"להשקות"},{"word":"sweet","partOfSpeech":"adjective","definition":"מתוק","example":"Sweet tomatoes.","translation":"מתוק"}],"questions":[{"question":"What does Grandpa grow?","options":["Only flowers","Tomatoes, carrots and flowers","Trees","Grass"],"correctIndex":1,"explanation":"'He grows tomatoes, carrots and flowers'."},{"question":"How are the tomatoes?","options":["Green and sour","Red and sweet","Small","Hard"],"correctIndex":1,"explanation":"'The tomatoes are red and sweet'."}]},{"title":"The Birthday Cake (עוגת יום ההולדת)","text":"Today is my sister's birthday. Mum and I make a chocolate cake. We put seven candles on it. My sister is very happy. She blows out the candles and we all sing.","glossary":[{"word":"candle","partOfSpeech":"noun","definition":"נר","example":"Seven candles.","translation":"נר"},{"word":"blow out","partOfSpeech":"phrase","definition":"לכבות בנשיפה","example":"Blow out the candles.","translation":"לכבות בנשיפה"},{"word":"happy","partOfSpeech":"adjective","definition":"שמח","example":"Very happy.","translation":"שמח"}],"questions":[{"question":"How many candles are on the cake?","options":["Five","Six","Seven","Eight"],"correctIndex":2,"explanation":"'We put seven candles on it'."},{"question":"What does the sister do?","options":["Cut the cake","Blow out the candles","Cry","Run"],"correctIndex":1,"explanation":"'She blows out the candles'."}]},{"title":"Waiting for the Rain to Stop (מחכים שהגשם ייפסק)","text":"We wanted to play outside, but it started to rain. So we sat by the window and watched the drops. My brother counted the cars in the street. When the sun came back, we ran out to play.","glossary":[{"word":"rain","partOfSpeech":"verb","definition":"לרדת גשם","example":"It started to rain.","translation":"לרדת גשם"},{"word":"drops","partOfSpeech":"noun","definition":"טיפות","example":"Watch the drops.","translation":"טיפות"},{"word":"count","partOfSpeech":"verb","definition":"לספור","example":"Count the cars.","translation":"לספור"}],"questions":[{"question":"Why did they stay inside?","options":["It was cold","It started to rain","It was late","They were tired"],"correctIndex":1,"explanation":"'it started to rain'."},{"question":"What did the brother do?","options":["Slept","Counted the cars","Read","Sang"],"correctIndex":1,"explanation":"'My brother counted the cars'."}]},{"title":"My School Bag (התיק שלי)","text":"I have a blue school bag. Inside there are books, pens and a small box for lunch. The bag is heavy on Mondays. I carry it on my back every day.","glossary":[{"word":"bag","partOfSpeech":"noun","definition":"תיק","example":"A school bag.","translation":"תיק"},{"word":"heavy","partOfSpeech":"adjective","definition":"כבד","example":"It is heavy.","translation":"כבד"},{"word":"carry","partOfSpeech":"verb","definition":"לשאת, לסחוב","example":"I carry it.","translation":"לשאת/לסחוב"}],"questions":[{"question":"What colour is the bag?","options":["Red","Blue","Green","Black"],"correctIndex":1,"explanation":"'a blue school bag'."},{"question":"When is the bag heavy?","options":["On Fridays","On Mondays","On Sundays","Every night"],"correctIndex":1,"explanation":"'heavy on Mondays'."}]},{"title":"The Little Red Ball (הכדור האדום הקטן)","text":"My dog Rex loves his little red ball. I throw it and he runs fast. He brings it back to me every time. We play in the garden until the sun goes down.","glossary":[{"word":"throw","partOfSpeech":"verb","definition":"לזרוק","example":"I throw the ball.","translation":"לזרוק"},{"word":"fast","partOfSpeech":"adverb","definition":"מהר","example":"He runs fast.","translation":"מהר"},{"word":"bring","partOfSpeech":"verb","definition":"להביא","example":"He brings it back.","translation":"להביא"}],"questions":[{"question":"What does Rex love?","options":["A bone","His little red ball","A stick","Food"],"correctIndex":1,"explanation":"'his little red ball'."},{"question":"Where do they play?","options":["In the park","In the garden","Inside","On the street"],"correctIndex":1,"explanation":"'We play in the garden'."}]},{"title":"Brushing My Teeth (מצחצח שיניים)","text":"Every morning and every night I brush my teeth. I use a green toothbrush and white toothpaste. It takes two minutes. Clean teeth are healthy and strong.","glossary":[{"word":"brush","partOfSpeech":"verb","definition":"לצחצח, להבריש","example":"Brush your teeth.","translation":"לצחצח"},{"word":"teeth","partOfSpeech":"noun","definition":"שיניים","example":"Clean teeth.","translation":"שיניים"},{"word":"healthy","partOfSpeech":"adjective","definition":"בריא","example":"Healthy teeth.","translation":"בריא"}],"questions":[{"question":"How often does the child brush?","options":["Once a day","Morning and night","Once a week","Never"],"correctIndex":1,"explanation":"'Every morning and every night'."},{"question":"How long does it take?","options":["One minute","Two minutes","Five minutes","Ten minutes"],"correctIndex":1,"explanation":"'It takes two minutes'."}]},{"title":"A Visit to the Farm (ביקור בחווה)","text":"On the farm we see cows, sheep and a brown horse. The farmer gives us fresh milk. I feed the chickens with corn. The farm smells of grass and animals.","glossary":[{"word":"farm","partOfSpeech":"noun","definition":"חווה, משק","example":"On the farm.","translation":"חווה/משק"},{"word":"sheep","partOfSpeech":"noun","definition":"כבשה/כבשים","example":"We see sheep.","translation":"כבשה/כבשים"},{"word":"feed","partOfSpeech":"verb","definition":"להאכיל","example":"I feed the chickens.","translation":"להאכיל"}],"questions":[{"question":"What colour is the horse?","options":["Black","Brown","White","Grey"],"correctIndex":1,"explanation":"'a brown horse'."},{"question":"What does the child feed the chickens?","options":["Bread","Corn","Grass","Milk"],"correctIndex":1,"explanation":"'I feed the chickens with corn'."}]},{"title":"My Best Friend (החבר הכי טוב שלי)","text":"My best friend is Omar. We sit together at school and share our snacks. He is funny and makes me laugh. After school we ride our bikes home.","glossary":[{"word":"share","partOfSpeech":"verb","definition":"לחלוק","example":"We share snacks.","translation":"לחלוק"},{"word":"funny","partOfSpeech":"adjective","definition":"מצחיק","example":"He is funny.","translation":"מצחיק"},{"word":"laugh","partOfSpeech":"verb","definition":"לצחוק","example":"He makes me laugh.","translation":"לצחוק"}],"questions":[{"question":"Who is the best friend?","options":["Omar","Rex","Sam","Ben"],"correctIndex":0,"explanation":"'My best friend is Omar'."},{"question":"What do they do after school?","options":["Study","Ride their bikes home","Watch TV","Sleep"],"correctIndex":1,"explanation":"'we ride our bikes home'."}]}]