[{"title":"My Morning (הבוקר שלי)","text":"I wake up at seven. I drink water and eat bread with cheese. Then I go to work by bus. The bus is often full, but I like to look out the window.","glossary":[{"word":"wake up","partOfSpeech":"verb","definition":"להתעורר משינה","example":"I wake up early.","translation":"להתעורר"},{"word":"bus","partOfSpeech":"noun","definition":"כלי תחבורה ציבורי גדול","example":"The bus is full.","translation":"אוטובוס"},{"word":"full","partOfSpeech":"adjective","definition":"מלא, אין מקום פנוי","example":"The cup is full.","translation":"מלא"}],"questions":[{"question":"When does the writer wake up?","options":["At six","At seven","At eight","At nine"],"correctIndex":1,"explanation":"כתוב 'I wake up at seven'."},{"question":"How does the writer go to work?","options":["By car","By bike","By bus","On foot"],"correctIndex":2,"explanation":"כתוב 'I go to work by bus'."}]},{"title":"My Friend Lia (החברה שלי ליה)","text":"Lia is my friend. She lives near my house. We go to school together every day. After school we play in the park and then we do our homework.","glossary":[{"word":"near","partOfSpeech":"preposition","definition":"קרוב ל-","example":"I live near the sea.","translation":"ליד/קרוב"},{"word":"together","partOfSpeech":"adverb","definition":"ביחד, עם מישהו","example":"We work together.","translation":"ביחד"},{"word":"homework","partOfSpeech":"noun","definition":"עבודה שעושים בבית אחרי בית הספר","example":"I do my homework.","translation":"שיעורי בית"}],"questions":[{"question":"Where does Lia live?","options":["Far away","Near the writer's house","In another city","At school"],"correctIndex":1,"explanation":"כתוב 'She lives near my house'."},{"question":"What do they do after school?","options":["Sleep","Play in the park","Go to work","Watch TV"],"correctIndex":1,"explanation":"כתוב 'we play in the park'."}]},{"title":"The Cat (החתול)","text":"I have a small cat. Her name is Mimi. She is black and white. Mimi sleeps all day and plays at night. I give her food in the morning and in the evening.","glossary":[{"word":"small","partOfSpeech":"adjective","definition":"קטן בגודלו","example":"A small cat.","translation":"קטן"},{"word":"sleep","partOfSpeech":"verb","definition":"לנוח עם עיניים עצומות","example":"I sleep at night.","translation":"לישון"},{"word":"evening","partOfSpeech":"noun","definition":"החלק האחרון של היום","example":"Good evening.","translation":"ערב"}],"questions":[{"question":"What colour is Mimi?","options":["All black","Black and white","Brown","Grey"],"correctIndex":1,"explanation":"כתוב 'She is black and white'."},{"question":"When does Mimi play?","options":["In the morning","At noon","At night","Never"],"correctIndex":2,"explanation":"כתוב 'plays at night'."}]},{"title":"At the Shop (בחנות)","text":"On Sunday I go to the shop. I buy milk, eggs and apples. The shop is near my house. The woman at the shop is very nice and she always says hello.","glossary":[{"word":"buy","partOfSpeech":"verb","definition":"לתת כסף ולקבל מוצר","example":"I buy bread.","translation":"לקנות"},{"word":"shop","partOfSpeech":"noun","definition":"מקום שבו קונים דברים","example":"The shop is open.","translation":"חנות"},{"word":"nice","partOfSpeech":"adjective","definition":"נחמד, טוב","example":"She is nice.","translation":"נחמד"}],"questions":[{"question":"What does the writer buy?","options":["Milk, eggs and apples","Bread and cheese","Only milk","Fish"],"correctIndex":0,"explanation":"כתוב 'milk, eggs and apples'."},{"question":"How is the woman at the shop?","options":["Tired","Angry","Nice","Busy"],"correctIndex":2,"explanation":"כתוב 'is very nice'."}]},{"title":"My Day Off (יום החופש שלי)","text":"Today I do not work. I stay at home. In the morning I read a book. In the afternoon my brother comes and we cook lunch. It is a good day.","glossary":[{"word":"stay","partOfSpeech":"verb","definition":"להישאר במקום","example":"I stay at home.","translation":"להישאר"},{"word":"cook","partOfSpeech":"verb","definition":"להכין אוכל","example":"We cook dinner.","translation":"לבשל"},{"word":"brother","partOfSpeech":"noun","definition":"אח","example":"My brother is tall.","translation":"אח"}],"questions":[{"question":"Where is the writer today?","options":["At work","At home","At school","At the park"],"correctIndex":1,"explanation":"כתוב 'I stay at home'."},{"question":"Who comes in the afternoon?","options":["A friend","The teacher","The brother","Nobody"],"correctIndex":2,"explanation":"כתוב 'my brother comes'."}]}]