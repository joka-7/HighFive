ion":"בבקשה שב."},{"text":"I have a drama class on Monday.","translation":"יש לי שיעור תיאטרון ביום שני."},{"text":"The bus driver is friendly.","translation":"נהג האוטובוס חביב."}]},{"prompts":[{"text":"I send an email to my teacher.","translation":"אני שולח מייל למורה שלי."},{"text":"I like the end of the story.","translation":"אני אוהב את הסוף של הסיפור."},{"text":"My mother is an engineer.","translation":"אמא שלי מהנדסת."},{"text":"These are my everyday shoes.","translation":"אלה הנעליים היומיומיות שלי."}]},{"prompts":[{"text":"Can you give me an example?","translation":"אתה יכול לתת לי דוגמה?"},{"text":"Your work is excellent!","translation":"העבודה שלך מצוינת!"},{"text":"The fairy has a magic wand.","translation":"לפיה יש שרביט קסמים."},{"text":"Is the sentence true or false?","translation":"המשפט נכון או לא נכון?"}]},{"prompts":[{"text":"My dog is very fast.","translation":"הכלב שלי מאוד מהיר."},{"text":"The cat is fat.","translation":"החתול שמן."},{"text":"February is a short month.","translation":"פברואר הוא חודש קצר."},{"text":"I feel happy today.","translation":"אני מרגיש שמח היום."}]},{"prompts":[{"text":"We go to a music festival.","translation":"אנחנו הולכים לפסטיבל מוזיקה."},{"text":"The cows are in the field.","translation":"הפרות בשדה."},{"text":"Save the file on the computer.","translation":"תשמור את הקובץ במחשב."},{"text":"I am fine, thank you.","translation":"אני בסדר, תודה."}]},{"prompts":[{"text":"They live in a small flat.","translation":"הם גרים בדירה קטנה."},{"text":"It is foggy this morning.","translation":"יש ערפל הבוקר."},{"text":"The foreigner asks for directions.","translation":"הזר שואל איך להגיע."},{"text":"Please fill in this form.","translation":"בבקשה תמלא את הטופס הזה."}]},{"prompts":[{"text":"The party is a lot of fun.","translation":"המסיבה מאוד כיפית."},{"text":"In the future, I want to be a doctor.","translation":"בעתיד אני רוצה להיות רופא."},{"text":"Take out the garbage, please.","translation":"תוציא את הזבל, בבקשה."},{"text":"I get a present on my birthday.","translation":"אני מקבל מתנה ביום ההולדת שלי."}]},{"prompts":[{"text":"His girlfriend is a teacher.","translation":"החברה שלו מורה."},{"text":"I am glad to see you.","translation":"אני שמח לראות אותך."},{"text":"The ring is made of gold.","translation":"הטבעת עשויה מזהב."},{"text":"We learn English grammar.","translation":"אנחנו לומדים דקדוק באנגלית."}]},{"prompts":[{"text":"I visit my grandparents on Saturday.","translation":"אני מבקר את סבא וסבתא שלי בשבת."},{"text":"The apple falls to the ground.","translation":"התפוח נופל לאדמה."},{"text":"We work in groups of four.","translation":"אנחנו עובדים בקבוצות של ארבעה."},{"text":"Guess what I have in my bag!","translation":"נחש מה יש לי בתיק!"}]},{"prompts":[{"text":"He is a nice guy.","translation":"הוא בחור נחמד."},{"text":"Reading every day is a good habit.","translation":"לקרוא כל יום זה הרגל טוב."},{"text":"I need a haircut.","translation":"אני צריך תספורת."},{"text":"Wait for me in the hall.","translation":"חכה לי במסדרון."}]},{"prompts":[{"text":"Your brother is handsome.","translation":"אחיך נאה."},{"text":"What happens at the end of the movie?","translation":"מה קורה בסוף הסרט?"},{"text":"This question is hard.","translation":"השאלה הזאת קשה."},{"text":"I can hear the birds.","translation":"אני יכול לשמוע את הציפורים."}]},{"prompts":[{"text":"I like history lessons.","translation":"אני אוהב שיעורי היסטוריה."},{"text":"There is a hole in my sock.","translation":"יש חור בגרב שלי."},{"text":"Haifa is my hometown.","translation":"חיפה היא עיר הולדתי."},{"text":"I love chocolate ice cream.","translation":"אני אוהב גלידת שוקולד."}]},{"prompts":[{"text":"Water is important for our body.","translation":"מים חשובים לגוף שלנו."},{"text":"I need information about the trip.","translation":"אני צריך מידע על הטיול."},{"text":"I am interested in animals.","translation":"אני מתעניין בבעלי חיים."},{"text":"This book is very interesting.","translation":"הספר הזה מאוד מעניין."}]},{"prompts":[{"text":"The singer gives an interview on TV.","translation":"הזמרת נותנת ראיון בטלוויזיה."},{"text":"There are ten items on the list.","translation":"יש עשרה פריטים ברשימה."},{"text":"The year begins in January.","translation":"השנה מתחילה בינואר."},{"text":"I wear jeans to school.","translation":"אני לובש ג'ינס לבית הספר."}]},{"prompts":[{"text":"We go to the beach in July.","translation":"אנחנו הולכים לים ביולי."},{"text":"School ends in June.","translation":"הלימודים נגמרים ביוני."},{"text":"You can keep the book.","translation":"אתה יכול לשמור את הספר."},{"text":"The kids play in the garden.","translation":"הילדים משחקים בגינה."}]},{"prompts":[{"text":"We fly a kite at the beach.","translation":"אנחנו מעיפים עפיפון בחוף."},{"text":"The old lady has a small dog.","translation":"לגברת הזקנה יש כלב קטן."},{"text":"I speak two languages.","translation":"אני מדבר שתי שפות."},{"text":"We have a large garden.","translation":"יש לנו גינה גדולה."}]}]