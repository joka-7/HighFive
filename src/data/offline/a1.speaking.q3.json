pts":[{"text":"The dog has a bone.","translation":"לכלב יש עצם."},{"text":"I buy books at the bookstore.","translation":"אני קונה ספרים בחנות הספרים."},{"text":"Both my sisters are tall.","translation":"שתי האחיות שלי גבוהות."},{"text":"The ball is at the bottom of the box.","translation":"הכדור בתחתית הקופסה."}]},{"prompts":[{"text":"Your brain is in your head.","translation":"המוח שלך נמצא בראש."},{"text":"The sun is very bright.","translation":"השמש מאירה חזק מאוד."},{"text":"Please bring your book tomorrow.","translation":"בבקשה תביא את הספר שלך מחר."},{"text":"My phone is broken.","translation":"הטלפון שלי שבור."}]},{"prompts":[{"text":"We build a sandcastle on the beach.","translation":"אנחנו בונים ארמון חול בחוף."},{"text":"We live in a tall building.","translation":"אנחנו גרים בבניין גבוה."},{"text":"My uncle has a small business.","translation":"לדוד שלי יש עסק קטן."},{"text":"A butterfly is on the flower.","translation":"יש פרפר על הפרח."}]},{"prompts":[{"text":"Bye! See you tomorrow.","translation":"ביי! נתראה מחר."},{"text":"I go to summer camp in July.","translation":"אני הולך לקייטנת קיץ ביולי."},{"text":"He wears a blue cap.","translation":"הוא חובש כובע כחול."},{"text":"Take care of your little brother.","translation":"תשמור על אחיך הקטן."}]},{"prompts":[{"text":"The kids watch a cartoon.","translation":"הילדים צופים בסרט מצויר."},{"text":"We have a big celebration for Hanukkah.","translation":"יש לנו חגיגה גדולה לחנוכה."},{"text":"Who is your favorite character?","translation":"מי הדמות האהובה עליך?"},{"text":"Choose a color.","translation":"תבחר צבע."}]},{"prompts":[{"text":"Draw a circle on the page.","translation":"תצייר עיגול על הדף."},{"text":"There are thirty kids in my class.","translation":"יש שלושים ילדים בכיתה שלי."},{"text":"Dana is my classmate.","translation":"דנה היא חברה שלי לכיתה."},{"text":"Our classroom is on the second floor.","translation":"הכיתה שלנו בקומה השנייה."}]},{"prompts":[{"text":"It is cloudy today.","translation":"מעונן היום."},{"text":"I am in the football club.","translation":"אני במועדון הכדורגל."},{"text":"He has a big collection of toy cars.","translation":"יש לו אוסף גדול של מכוניות צעצוע."},{"text":"My sister goes to college.","translation":"אחותי לומדת במכללה."}]},{"prompts":[{"text":"Grandma makes chocolate cookies.","translation":"סבתא מכינה עוגיות שוקולד."},{"text":"Your new bag is cool!","translation":"התיק החדש שלך מגניב!"},{"text":"Copy the words into your notebook.","translation":"תעתיק את המילים למחברת שלך."},{"text":"Dad sleeps on the couch.","translation":"אבא ישן על הספה."}]},{"prompts":[{"text":"Can I pay by credit card?","translation":"אפשר לשלם בכרטיס אשראי?"},{"text":"What a cute baby!","translation":"איזה תינוק חמוד!"},{"text":"My dad cooks dinner.","translation":"אבא שלי מבשל ארוחת ערב."},{"text":"What is the date today?","translation":"מה התאריך היום?"}]},{"prompts":[{"text":"It rains a lot in December.","translation":"יורד הרבה גשם בדצמבר."},{"text":"I like the design of your shirt.","translation":"אני אוהב את העיצוב של החולצה שלך."},{"text":"Look for the word in the dictionary.","translation":"תחפש את המילה במילון."},{"text":"This test is difficult.","translation":"המבחן הזה קשה."}]},{"prompts":[{"text":"Please wash the dishes.","translation":"בבקשה תשטוף את הכלים."},{"text":"The book is ten dollars.","translation":"הספר עולה עשרה דולר."},{"text":"Please sit down.","translation":"בבקשה שב."},{"text":"I have a drama class on Monday.","translation":"יש לי שיעור תיאטרון ביום שני."}]},{"prompts":[{"text":"He plays the drums.","translation":"הוא מנגן בתופים."},{"text":"I write an email to my teacher.","translation":"אני כותב מייל למורה שלי."},{"text":"I like the end of the story.","translation":"אני אוהב את הסוף של הסיפור."},{"text":"My mother is an engineer.","translation":"אמא שלי מהנדסת."}]},{"prompts":[{"text":"There are toys everywhere.","translation":"יש צעצועים בכל מקום."},{"text":"Can you give me an example?","translation":"אתה יכול לתת לי דוגמה?"},{"text":"Your work is excellent!","translation":"העבודה שלך מצוינת!"},{"text":"The fairy can fly.","translation":"הפיה יודעת לעוף."}]},{"prompts":[{"text":"Turn on the fan, it is hot.","translation":"תדליק את המאוורר, חם."},{"text":"My dog is very fast.","translation":"הכלב שלי מאוד מהיר."},{"text":"The cat is fat.","translation":"החתול שמן."},{"text":"February is a short month.","translation":"פברואר הוא חודש קצר."}]},{"prompts":[{"text":"Tell me about your feelings.","translation":"ספר לי על הרגשות שלך."},{"text":"We go to a music festival.","translation":"אנחנו הולכים לפסטיבל מוזיקה."},{"text":"The cows are in the field.","translation":"הפרות בשדה."},{"text":"Save the file on the computer.","translation":"תשמור את הקובץ במחשב."}]},{"prompts":[{"text":"The flag of Israel is blue and white.","translation":"הדגל של ישראל כחול ולבן."},{"text":"They live in a small flat.","translation":"הם גרים בדירה קטנה."},{"text":"It is foggy this morning.","translation":"יש ערפל הבוקר."},{"text":"The foreigner asks for help.","translation":"הזר מבקש עזרה."}]},{"prompts":[{"text":"I sit in the front of the bus.","translation":"אני יושב בחלק הקדמי של האוטובוס."},{"text":"The party is a lot of fun.","translation":"המסיבה מאוד כיפית."},{"text":"In the future, I want to be a doctor.","translation":"בעתיד אני רוצה להיות רופא."},{"text":"Take out the garbage, please.","translation":"תוציא את הזבל, בבקשה."}]},{"prompts":[{"text":"The story is about a nice ghost.","translation":"הסיפור הוא על רוח רפאים נחמדה."},{"text":"His girlfriend is a teacher.","translation":"החברה שלו מורה."},{"text":"I am glad to see you.","translation":"אני שמח לראות אותך."},{"text":"The ring is made of gold.","translation":"הטבעת עשויה מזהב."}]},{"prompts":[{"text":"My grandma makes the best soup.","translation":"סבתא שלי מכינה את המרק הכי טוב."},{"text":"I visit my grandparents on Saturday.","translation":"אני מבקר את סבא וסבתא שלי בשבת."},{"text":"The ball is on the ground.","translation":"הכדור על האדמה."},{"text":"We work in groups of four.","translation":"אנחנו עובדים בקבוצות של ארבעה."}]},{"prompts":[{"text":"We have guests for dinner.","translation":"יש לנו אורחים לארוחת ערב."},{"text":"He is a nice guy.","translation":"הוא בחור נחמד."},{"text":"Reading every day is a good habit.","translation":"לקרוא כל יום זה הרגל טוב."},{"text":"I need a haircut.","translation":"אני צריך תספורת."}]},{"prompts":[{"text":"I want a hamburger and a drink.","translation":"אני רוצה המבורגר ומשהו לשתות."},{"text":"Your brother is handsome.","translation":"אחיך נאה."},{"text":"What happens at the end of the movie?","translation":"מה קורה בסוף הסרט?"},{"text":"This question is hard.","translation":"השאלה הזאת קשה."}]},{"prompts":[{"text":"The wall is very high.","translation":"הקיר מאוד גבוה."},{"text":"I like history lessons.","translation":"אני אוהב שיעורי היסטוריה."},{"text":"There is a hole in my sock.","translation":"יש חור בגרב שלי."},{"text":"Haifa is my hometown.","translation":"חיפה היא עיר הולדתי."}]},{"prompts":[{"text":"I have a good idea!","translation":"יש לי רעיון טוב!"},{"text":"Water is important for our body.","translation":"מים חשובים לגוף שלנו."},{"text":"I need information about the trip.","translation":"אני צריך מידע על הטיול."},{"text":"I am interested in animals.","translation":"אני מתעניין בבעלי חיים."}]},{"prompts":[{"text":"I find information on the internet.","translation":"אני מוצא מידע באינטרנט."},{"text":"The singer gives an interview on TV.","translation":"הזמרת נותנת ראיון בטלוויזיה."},{"text":"There are ten items on the list.","translation":"יש עשרה פריטים ברשימה."},{"text":"The year begins in January.","translation":"השנה מתחילה בינואר."}]},{"prompts":[{"text":"She keeps her jewelry in a box.","translation":"היא שומרת את התכשיטים שלה בקופסה."},{"text":"We go to the beach in July.","translation":"אנחנו הולכים לים ביולי."},{"text":"School ends in June.","translation":"הלימודים נגמרים ביוני."},{"text":"You can keep the book.","translation":"אתה יכול לשמור את הספר."}]},{"prompts":[{"text":"The king lives in a palace.","translation":"המלך גר בארמון."},{"text":"We fly a kite at the beach.","translation":"אנחנו מעיפים עפיפון בחוף."},{"text":"The old lady has a small dog.","translation":"לגברת הזקנה יש כלב קטן."},{"text":"I speak two languages.","translation":"אני מדבר שתי שפות."}]},{"prompts":[{"text":"What is your last name?","translation":"מה שם המשפחה שלך?"},{"text":"Sorry, I am late.","translation":"סליחה, אני מאחר."},{"text":"See you later!","translation":"נתראה אחר כך!"},{"text":"My cat is lazy.","translation":"החתול שלי עצלן."}]},{"prompts":[{"text":"This leaf is green.","translation":"העלה הזה ירוק."},{"text":"I leave home at seven.","translation":"אני יוצא מהבית בשבע."},{"text":"I write with my left hand.","translation":"אני כותב ביד שמאל."},{"text":"The English lesson is fun.","translation":"השיעור באנגלית כיפי."}]},{"prompts":[{"text":"My grandpa has a happy life.","translation":"לסבא שלי יש חיים שמחים."},{"text":"Draw a line under the word.","translation":"תמתח קו מתחת למילה."},{"text":"Mom writes a shopping list.","translation":"אמא כותבת רשימת קניות."},{"text":"I live in Tel Aviv.","translation":"אני גר בתל אביב."}]}]