anslation":"מה המילה הזו אומרת?"},{"text":"I do my homework.","translation":"אני עושה את שיעורי הבית."}]},{"prompts":[{"text":"The teacher writes on the board.","translation":"המורה כותבת על הלוח."},{"text":"There are thirty kids in my class.","translation":"יש שלושים ילדים בכיתה שלי."},{"text":"Dana is my classmate.","translation":"דנה היא חברה שלי לכיתה."},{"text":"Our classroom is on the second floor.","translation":"הכיתה שלנו בקומה השנייה."}]},{"prompts":[{"text":"Look for the word in the dictionary.","translation":"תחפש את המילה במילון."},{"text":"I have a drama class on Monday.","translation":"יש לי שיעור תיאטרון ביום שני."},{"text":"Can you give me an example?","translation":"אתה יכול לתת לי דוגמה?"},{"text":"We learn English grammar.","translation":"אנחנו לומדים דקדוק באנגלית."}]},{"prompts":[{"text":"I speak two languages.","translation":"אני מדבר שתי שפות."},{"text":"The English lesson is fun.","translation":"השיעור באנגלית כיפי."},{"text":"Math is my favorite subject.","translation":"מתמטיקה היא המקצוע האהוב עליי."},{"text":"Write the date in your notebook.","translation":"תכתוב את התאריך במחברת שלך."}]},{"prompts":[{"text":"Read the first paragraph.","translation":"תקרא את הפסקה הראשונה."},{"text":"I have football practice today.","translation":"יש לי אימון כדורגל היום."},{"text":"Can I ask a question?","translation":"אפשר לשאול שאלה?"},{"text":"Use a ruler to draw a line.","translation":"תשתמש בסרגל כדי למתוח קו."}]},{"prompts":[{"text":"Write a sentence with this word.","translation":"תכתוב משפט עם המילה הזאת."},{"text":"I study English every day.","translation":"אני לומד אנגלית כל יום."},{"text":"English is my best subject.","translation":"אנגלית היא המקצוע הכי חזק שלי."},{"text":"We have a test tomorrow.","translation":"יש לנו מבחן מחר."}]},{"prompts":[{"text":"Underline the new words.","translation":"תמתח קו מתחת למילים החדשות."},{"text":"I am in sixth grade, and my test grade was 90.","translation":"אני בכיתה ו', והציון שלי במבחן היה 90."},{"text":"My little brother goes to elementary school.","translation":"אחי הקטן הולך לבית ספר יסודי."},{"text":"Write your name in the blank.","translation":"כתבו את השם שלכם במקום הריק."}]},{"prompts":[{"text":"We do a survey in class.","translation":"אנחנו עושים סקר בכיתה."},{"text":"The children's section is on the first floor.","translation":"אזור הילדים בקומה הראשונה."},{"text":"Reading is fun.","translation":"קריאה זה כיף."},{"text":"I go to work by bus.","translation":"אני הולך לעבודה באוטובוס."}]},{"prompts":[{"text":"We walk to school.","translation":"אנחנו הולכים לבית הספר."},{"text":"Please open the door.","translation":"בבקשה פתח את הדלת."},{"text":"I read before I sleep.","translation":"אני קורא לפני שאני הולך לישון."},{"text":"Write your name here.","translation":"כתוב את שמך כאן."}]},{"prompts":[{"text":"Stand up, please.","translation":"קום, בבקשה."},{"text":"Wash your hands.","translation":"שטוף את הידיים."},{"text":"I run every day.","translation":"אני רץ כל יום."},{"text":"I sleep eight hours.","translation":"אני ישן שמונה שעות."}]},{"prompts":[{"text":"I wake up at seven.","translation":"אני מתעורר בשבע."},{"text":"Brush your teeth.","translation":"צחצח את השיניים."},{"text":"I can hear the birds.","translation":"אני יכול לשמוע את הציפורים."},{"text":"Say hello to your mom.","translation":"תגיד שלום לאמא שלך."}]},{"prompts":[{"text":"I talk with my friends.","translation":"אני מדבר עם החברים שלי."},{"text":"I love this song.","translation":"אני אוהב את השיר הזה."},{"text":"I know the answer.","translation":"אני יודע את התשובה."},{"text":"I like ice cream.","translation":"אני אוהב גלידה."}]},{"prompts":[{"text":"She smiled at me.","translation":"היא חייכה אליי."},{"text":"The baby cried.","translation":"התינוק בכה."},{"text":"The kids play outside.","translation":"הילדים משחקים בחוץ."},{"text":"I buy bread.","translation":"אני קונה לחם."}]},{"prompts":[{"text":"Take an apple.","translation":"קח תפוח."},{"text":"Make a cake.","translation":"הכן עוגה."},{"text":"Put it on the table.","translation":"שים את זה על השולחן."},{"text":"I can't find my keys.","translation":"אני לא מוצא את המפתחות."}]},{"prompts":[{"text":"I carry the bag.","translation":"אני נושא את התיק."},{"text":"I draw pictures.","translation":"אני מצייר תמונות."},{"text":"I feed the cat.","translation":"אני מאכיל את החתול."},{"text":"We swim.","translation":"אנחנו שוחים."}]},{"prompts":[{"text":"I hug him.","translation":"אני מחבק אותו."},{"text":"We share snacks.","translation":"אנחנו חולקים חטיפים."},{"text":"He makes me laugh.","translation":"הוא גורם לי לצחוק."},{"text":"Throw the ball.","translation":"זרוק את הכדור."}]},{"prompts":[{"text":"The lesson begins at nine.","translation":"השיעור מתחיל בתשע."},{"text":"Please bring your book tomorrow.","translation":"בבקשה תביא את הספר שלך מחר."},{"text":"We build a sandcastle on the beach.","translation":"אנחנו בונים ארמון חול בחוף."},{"text":"Choose a color.","translation":"תבחר צבע."}]},{"prompts":[{"text":"I feel happy today.","translation":"אני מרגיש שמח היום."},{"text":"Guess what I have in my bag!","translation":"נחש מה יש לי בתיק!"},{"text":"What happens at the end of the movie?","translation":"מה קורה בסוף הסרט?"},{"text":"You can keep the book.","translation":"אתה יכול לשמור את הספר."}]},{"prompts":[{"text":"Let me help you.","translation":"תן לי לעזור לך."},{"text":"What does this word mean?","translation":"מה המילה הזאת אומרת?"},{"text":"Nice to meet you!","translation":"נעים להכיר!"},{"text":"People pray in the synagogue.","translation":"אנשים מתפללים בבית הכנסת."}]},{"prompts":[{"text":"I spend my weekend with my family.","translation":"אני מבלה את סוף השבוע עם המשפחה שלי."},{"text":"I stay at home on Saturdays.","translation":"אני נשאר בבית בשבת."},{"text":"I wait at the bus stop.","translation":"אני מחכה בתחנת האוטובוס."},{"text":"My mom teaches math.","translation":"אמא שלי מלמדת מתמטיקה."}]}]