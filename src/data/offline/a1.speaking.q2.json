sday.","translation":"יש לנו אמנות ביום שלישי."},{"text":"It is your turn to play.","translation":"תורך לשחק."}]},{"prompts":[{"text":"What type of music do you like?","translation":"איזה סוג מוזיקה אתה אוהב?"},{"text":"The monster in the story is ugly.","translation":"המפלצת בסיפור מכוערת."},{"text":"Underline the new words.","translation":"תמתח קו מתחת למילים החדשות."},{"text":"Can I use your pencil?","translation":"אני יכול להשתמש בעיפרון שלך?"}]},{"prompts":[{"text":"We go on vacation in August.","translation":"אנחנו יוצאים לחופשה באוגוסט."},{"text":"Put the flowers in the vase.","translation":"תשים את הפרחים באגרטל."},{"text":"We watch a funny video.","translation":"אנחנו צופים בסרטון מצחיק."},{"text":"Thank you for your visit.","translation":"תודה על הביקור שלך."}]},{"prompts":[{"text":"The waiter brings our food.","translation":"המלצר מביא את האוכל שלנו."},{"text":"The waitress is very kind.","translation":"המלצרית מאוד נחמדה."},{"text":"I want a glass of water.","translation":"אני רוצה כוס מים."},{"text":"Is this the way to the beach?","translation":"זו הדרך לחוף?"}]},{"prompts":[{"text":"We have a test on Wednesday.","translation":"יש לנו מבחן ביום רביעי."},{"text":"Make a wish and blow out the candles!","translation":"תבקש משאלה ותכבה את הנרות!"},{"text":"The workers build a new road.","translation":"העובדים בונים כביש חדש."},{"text":"She is a famous writer.","translation":"היא סופרת מפורסמת."}]},{"prompts":[{"text":"I eat yogurt for breakfast.","translation":"אני אוכל יוגורט לארוחת בוקר."},{"text":"I am a bit tired today, let's rest.","translation":"אני קצת עייף היום, בוא ננוח."},{"text":"I am not hungry at all, thank you.","translation":"אני בכלל לא רעב, תודה."},{"text":"Drink at least five glasses of water every day.","translation":"שתו לפחות חמש כוסות מים בכל יום."}]},{"prompts":[{"text":"Look both ways before you cross the street.","translation":"הסתכל לשני הצדדים לפני שאתה חוצה את הכביש."},{"text":"I need to find out when the bus leaves.","translation":"אני צריך לברר מתי האוטובוס יוצא."},{"text":"Our class will go on a trip next Friday.","translation":"הכיתה שלנו תצא לטיול ביום שישי הבא."},{"text":"I am in sixth grade, and my final grade was 90.","translation":"אני בכיתה ו', והציון הסופי שלי היה 90."}]},{"prompts":[{"text":"I am waiting for you right in front of the school.","translation":"אני מחכה לך ממש מול בית הספר."},{"text":"It was a hard game, but we won in the end.","translation":"זה היה משחק קשה, אבל ניצחנו בסוף."},{"text":"She is very interested in music and art.","translation":"היא מאוד מתעניינת במוזיקה ובאמנות."},{"text":"Please lie down on the bed and rest.","translation":"בבקשה שכב על המיטה ותנוח."}]},{"prompts":[{"text":"I can do my homework on my own.","translation":"אני יכול להכין את שיעורי הבית לבד."},{"text":"Please pick up your bag from the floor.","translation":"בבקשה הרם את התיק שלך מהרצפה."},{"text":"Turn right at the corner; that is the right way.","translation":"פנה ימינה בפינה; זאת הדרך הנכונה."},{"text":"You look very smart in that new shirt!","translation":"אתה נראה מאוד אלגנטי בחולצה החדשה!"}]},{"prompts":[{"text":"They are still waiting for the bus outside.","translation":"הם עדיין מחכים לאוטובוס בחוץ."},{"text":"My house is near the school.","translation":"הבית שלי ליד בית הספר."},{"text":"I drink water every morning.","translation":"אני שותה מים כל בוקר."},{"text":"She is my best friend.","translation":"היא החברה הכי טובה שלי."}]},{"prompts":[{"text":"They live in a big city.","translation":"הם גרים בעיר גדולה."},{"text":"We eat dinner at seven.","translation":"אנחנו אוכלים ארוחת ערב בשבע."},{"text":"I go to work by bus.","translation":"אני הולך לעבודה באוטובוס."},{"text":"Good morning!","translation":"בוקר טוב!"}]},{"prompts":[{"text":"I love my family.","translation":"אני אוהב את המשפחה שלי."},{"text":"Have a nice day.","translation":"שיהיה לך יום נעים."},{"text":"This book is very good.","translation":"הספר הזה מאוד טוב."},{"text":"I love this song.","translation":"אני אוהב את השיר הזה."}]},{"prompts":[{"text":"What is your name?","translation":"מה השם שלך?"},{"text":"I work in an office.","translation":"אני עובד במשרד."},{"text":"This is a good idea.","translation":"זו רעיון טוב."},{"text":"The child is playing.","translation":"הילד משחק."}]},{"prompts":[{"text":"The woman is a doctor.","translation":"האישה היא רופאה."},{"text":"The man is reading.","translation":"הגבר קורא."},{"text":"Tel Aviv is a big city.","translation":"תל אביב היא עיר גדולה."},{"text":"The food is delicious.","translation":"האוכל טעים."}]},{"prompts":[{"text":"I can see the sea.","translation":"אני יכול לראות את הים."},{"text":"I know the answer.","translation":"אני יודע את התשובה."},{"text":"I like ice cream.","translation":"אני אוהב גלידה."},{"text":"I have a new phone.","translation":"יש לי טלפון חדש."}]},{"prompts":[{"text":"The soup is hot.","translation":"המרק חם."},{"text":"The water is cold.","translation":"המים קרים."},{"text":"We walk to school.","translation":"אנחנו הולכים לבית הספר."},{"text":"Please open the door.","translation":"בבקשה פתח את הדלת."}]},{"prompts":[{"text":"Write your name here.","translation":"כתוב את שמך כאן."},{"text":"My room is small.","translation":"החדר שלי קטן."},{"text":"My mother is a nurse.","translation":"אמא שלי היא אחות."},{"text":"His father drives a bus.","translation":"אבא שלו נוהג באוטובוס."}]},{"prompts":[{"text":"Her sister is tall.","translation":"אחותה גבוהה."},{"text":"The dog is friendly.","translation":"הכלב ידידותי."},{"text":"The cat is sleeping.","translation":"החתול ישן."},{"text":"We have a red car.","translation":"יש לנו מכונית אדומה."}]},{"prompts":[{"text":"The sun is bright today.","translation":"השמש בהירה היום."},{"text":"Look at the moon!","translation":"תסתכל על הירח!"},{"text":"I don't like the rain.","translation":"אני לא אוהב גשם."},{"text":"Good night!","translation":"לילה טוב!"}]},{"prompts":[{"text":"Wash your hands.","translation":"שטוף את הידיים."},{"text":"She has blue eyes.","translation":