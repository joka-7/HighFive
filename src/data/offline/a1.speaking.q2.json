rass.","translation":"הפרה אוכלת עשב."}]},{"prompts":[{"text":"We sat in the garden.","translation":"ישבנו בגינה."},{"text":"Mum is in the kitchen.","translation":"אמא במטבח."},{"text":"Cross the street carefully.","translation":"חצה את הרחוב בזהירות."},{"text":"The shop is open.","translation":"החנות פתוחה."}]},{"prompts":[{"text":"The train is fast.","translation":"הרכבת מהירה."},{"text":"The sky is clear.","translation":"השמיים בהירים."},{"text":"My leg hurts.","translation":"הרגל שלי כואבת."},{"text":"He broke his arm.","translation":"הוא שבר את הזרוע."}]},{"prompts":[{"text":"She has long hair.","translation":"יש לה שיער ארוך."},{"text":"Open your mouth.","translation":"פתח את הפה."},{"text":"A red nose.","translation":"אף אדום."},{"text":"I have an ear infection.","translation":"יש לי דלקת באוזן."}]},{"prompts":[{"text":"The baby is sleeping.","translation":"התינוק ישן."},{"text":"My grandmother bakes well.","translation":"סבתא שלי אופה טוב."},{"text":"My grandfather tells stories.","translation":"סבא שלי מספר סיפורים."},{"text":"I lost my key.","translation":"איבדתי את המפתח."}]},{"prompts":[{"text":"Answer the phone.","translation":"ענה לטלפון."},{"text":"The book is on the floor.","translation":"הספר על הרצפה."},{"text":"A picture on the wall.","translation":"תמונה על הקיר."},{"text":"A box of toys.","translation":"קופסת צעצועים."}]},{"prompts":[{"text":"What does this word mean?","translation":"מה המילה הזו אומרת?"},{"text":"Pick a number.","translation":"בחר מספר."},{"text":"A picture of the sea.","translation":"תמונה של הים."},{"text":"A birthday gift.","translation":"מתנת יום הולדת."}]},{"prompts":[{"text":"A cup of tea.","translation":"כוס תה."},{"text":"Eat with a spoon.","translation":"אכול בכפית."},{"text":"Use a fork.","translation":"השתמש במזלג."},{"text":"A cup of tea.","translation":"כוס תה."}]},{"prompts":[{"text":"A bowl of soup.","translation":"קערת מרק."},{"text":"I eat a banana.","translation":"אני אוכל בננה."},{"text":"A red tomato.","translation":"עגבנייה אדומה."},{"text":"Boiled potatoes.","translation":"תפוחי אדמה מבושלים."}]}]