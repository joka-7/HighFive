garden.","translation":"למלון יש גינה מושכת."}]},{"prompts":[{"text":"The shop has automatic doors.","translation":"לחנות יש דלתות אוטומטיות."},{"text":"The light turns on automatically.","translation":"האור נדלק מעצמו."},{"text":"She won an award for her drawing.","translation":"היא זכתה בפרס על הציור שלה."},{"text":"I slept badly last night.","translation":"ישנתי רע אתמול בלילה."}]},{"prompts":[{"text":"The kids have colorful balloons.","translation":"לילדים יש בלונים צבעוניים."},{"text":"We have a barbecue on Independence Day.","translation":"אנחנו עושים מנגל ביום העצמאות."},{"text":"Dad goes to the barber every month.","translation":"אבא הולך לספר כל חודש."},{"text":"I know some basic English words.","translation":"אני יודע כמה מילים בסיסיות באנגלית."}]},{"prompts":[{"text":"Haifa is on a beautiful bay.","translation":"חיפה נמצאת על מפרץ יפה."},{"text":"We enjoyed the beauty of the Galilee.","translation":"נהנינו מהיופי של הגליל."},{"text":"This class is for beginners.","translation":"השיעור הזה מיועד למתחילים."},{"text":"The baby has a round belly.","translation":"לתינוק יש בטן עגולה."}]},{"prompts":[{"text":"The teacher wrote on the blackboard.","translation":"המורה כתבה על הלוח."},{"text":"My sister has blonde hair.","translation":"לאחותי יש שיער בלונדיני."},{"text":"There was blood on his knee.","translation":"היה דם על הברך שלו."},{"text":"We play a board game every Friday night.","translation":"אנחנו משחקים משחק קופסה כל יום שישי בערב."}]},{"prompts":[{"text":"The bookcase is full of books.","translation":"ארון הספרים מלא ספרים."},{"text":"Put the dictionary on the bookshelf.","translation":"תשים את המילון על מדף הספרים."},{"text":"My mom's boss is very nice.","translation":"הבוס של אמא שלי מאוד נחמד."},{"text":"Let's brainstorm ideas for the party.","translation":"בואו נעשה סיעור מוחות לרעיונות למסיבה."}]},{"prompts":[{"text":"What brand are your shoes?","translation":"מאיזה מותג הנעליים שלך?"},{"text":"There is a cool breeze from the sea.","translation":"יש בריזה קרירה מהים."},{"text":"Our budget for the trip is small.","translation":"התקציב שלנו לטיול קטן."},{"text":"We need a new light bulb.","translation":"אנחנו צריכים נורה חדשה."}]},{"prompts":[{"text":"Meet me at the bus station.","translation":"תפגוש אותי בתחנה המרכזית."},{"text":"The cat is hiding in the bush.","translation":"החתול מתחבא בשיח."},{"text":"My uncle is a businessman.","translation":"הדוד שלי איש עסקים."},{"text":"Her mother is a successful businesswoman.","translation":"אמא שלה אשת עסקים מצליחה."}]},{"prompts":[{"text":"Write the date on the calendar.","translation":"תכתוב את התאריך בלוח השנה."},{"text":"The university campus is very big.","translation":"הקמפוס של האוניברסיטה מאוד גדול."},{"text":"Start a sentence with a capital letter.","translation":"תתחיל משפט באות גדולה."},{"text":"Yoni is the captain of our team.","translation":"יוני הוא הקפטן של הקבוצה שלנו."}]},{"prompts":[{"text":"The shop is in the city center.","translation":"החנות נמצאת במרכז העיר."},{"text":"The pencil is ten centimeters long.","translation":"העיפרון באורך עשרה סנטימטרים."},{"text":"This house is from the last century.","translation":"הבית הזה מהמאה הקודמת."},{"text":"I eat cereal with milk.","translation":"אני אוכל דגני בוקר עם חלב."}]},{"prompts":[{"text":"My bike chain is broken.","translation":"השרשרת של האופניים שלי שבורה."},{"text":"Our team won the championship.","translation":"הקבוצה שלנו זכתה באליפות."},{"text":"Read chapter three for homework.","translation":"תקראו את פרק שלוש לשיעורי הבית."},{"text":"Look at the chart on page six.","translation":"תסתכלו בטבלה בעמוד שש."}]},{"prompts":[{"text":"Grandma kissed me on the cheek.","translation":"סבתא נישקה אותי על הלחי."},{"text":"There was a chemical smell in the room.","translation":"היה ריח כימי בחדר."},{"text":"My grandfather taught me chess.","translation":"סבא שלי לימד אותי שחמט."},{"text":"The ball hit him in the chest.","translation":"הכדור פגע לו בחזה."}]},{"prompts":[{"text":"The chimpanzee is eating a banana.","translation":"השימפנזה אוכלת בננה."},{"text":"He has a cut on his chin.","translation":"יש לו חתך בסנטר."},{"text":"You have a choice of two desserts.","translation":"יש לך בחירה בין שני קינוחים."},{"text":"She is an Israeli citizen.","translation":"היא אזרחית ישראלית."}]},{"prompts":[{"text":"My dad listens to classical music.","translation":"אבא שלי מקשיב למוזיקה קלאסית."},{"text":"The cleaner comes on Tuesday.","translation":"המנקה באה ביום שלישי."},{"text":"The answer is clear.","translation":"התשובה ברורה."},{"text":"Please speak clearly.","translation":"בבקשה תדבר בבירור."}]},{"prompts":[{"text":"Click on the blue button.","translation":"תלחץ על הכפתור הכחול."},{"text":"The clown made the children laugh.","translation":"הליצן הצחיק את הילדים."},{"text":"Can you give me a clue?","translation":"אתה יכול לתת לי רמז?"},{"text":"I found a coin on the floor.","translation":"מצאתי מטבע על הרצפה."}]},{"prompts":[{"text":"Write the answers in the second column.","translation":"תכתבו את התשובות בעמודה השנייה."},{"text":"I need a comb for my hair.","translation":"אני צריך מסרק לשיער."},{"text":"My brother reads comics every day.","translation":"אחי קורא קומיקס כל יום."},{"text":"We communicate by email.","translation":"אנחנו שומרים על קשר במייל."}]},{"prompts":[{"text":"\"Taller\" is the comparative of \"tall\".","translation":"\"taller\" היא צורת ההשוואה של \"tall\"."},{"text":"I want to make a complaint.","translation":"אני רוצה להגיש תלונה."},{"text":"Mozart was a famous composer.","translation":"מוצרט היה מלחין מפורסם."},{"text":"The car is in good condition.","translation":"המכונית במצב טוב."}]},{"prompts":[{"text":"Put the food in a plastic container.","translation":"תשים את האוכל בקופסת פלסטיק."},{"text":"Africa is a big continent.","translation":"אפריקה היא יבשת גדולה."},{"text":"The driver lost control of the car.","translation":"הנהג איבד שליטה על המכונית."},{"text":"She answered all the questions correctly.","translation":"היא ענתה נכון על כל השאלות."}]},{"prompts":[{"text":"A young couple lives next door.","translation":"זוג צעיר גר בדירה הסמוכה."},{"text":"We play tennis on the school court.","translation":"אנחנו משחקים טניס במגרש של בית הספר."},{"text":"That's a crazy idea!","translation":"זה רעיון מטורף!"},{"text":"My sister is very creative.","translation":"אחותי מאוד יצירתית."}]},{"prompts":[{"text":"The sea is full of strange creatures.","translation":"הים מלא ביצורים מוזרים."},{"text":"Stealing is a crime.","translation":"גניבה היא פשע."},{"text":"The queen wears a gold crown.","translation":"המלכה עונדת כתר זהב."},{"text":"My grandparents went on a cruise.","translation":"סבא וסבתא שלי יצאו לשיט."}]},{"prompts":[{"text":"Cycling is good exercise.","translation":"רכיבה על אופניים היא פעילות גופנית טובה."},{"text":"I do sport every day; it's a daily habit.","translation":"אני עושה ספורט כל יום, זה הרגל יומי."},{"text":"The dam holds the water of the river.","translation":"הסכר עוצר את מי הנהר."},{"text":"She wants to be a dancer.","translation":"היא רוצה להיות רקדנית."}]},{"prompts":[{"text":"We want to get home in daylight.","translation":"אנחנו רוצים להגיע הביתה באור יום."},{"text":"The pool is very deep here.","translation":"הבריכה עמוקה מאוד כאן."},{"text":"Breathe deeply and relax.","translation":"תנשום עמוק ותירגע."},{"text":"It is thirty degrees today.","translation":"היום שלושים מעלות."}]}]