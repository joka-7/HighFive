[{"title":"The Bus to Work (האוטובוס לעבודה)","text":"I go to work by bus every morning. The bus comes at eight. I sit near the window and I read a book. The trip is short.","textHe":"אני נוסע לעבודה באוטובוס כל בוקר. האוטובוס מגיע בשמונה. אני יושב ליד החלון וקורא ספר. הנסיעה קצרה.","glossary":[{"word":"bus","partOfSpeech":"noun","definition":"כלי תחבורה ציבורי גדול","example":"The bus is full.","translation":"אוטובוס"},{"word":"window","partOfSpeech":"noun","definition":"פתח בקיר שמכניס אור","example":"I sit near the window.","translation":"חלון"},{"word":"short","partOfSpeech":"adjective","definition":"לא ארוך","example":"The trip is short.","translation":"קצר"}],"questions":[{"question":"When does the bus come?","questionHe":"מתי מגיע האוטובוס?","options":["At seven","At eight","At nine","At ten"],"optionsHe":["בשבע","בשמונה","בתשע","בעשר"],"correctIndex":1,"explanation":"כתוב 'The bus comes at eight'."},{"question":"What does the writer do on the bus?","questionHe":"מה עושה הכותב באוטובוס?","options":["Sleeps","Reads a book","Eats","Works"],"optionsHe":["ישן","קורא ספר","אוכל","עובד"],"correctIndex":1,"explanation":"כתוב 'I read a book'."}]},{"title":"A Cold Day (יום קר)","text":"Today it is very cold. I wear a warm coat and a hat. My sister makes hot tea for us. We sit at home and we look at the rain.","textHe":"היום מאוד קר. אני לובש מעיל חם וכובע. אחותי מכינה לנו תה חם. אנחנו יושבים בבית ומסתכלים על הגשם.","glossary":[{"word":"cold","partOfSpeech":"adjective","definition":"בטמפרטורה נמוכה","example":"The water is cold.","translation":"קר"},{"word":"coat","partOfSpeech":"noun","definition":"בגד חם שלובשים מעל","example":"I wear a coat.","translation":"מעיל"},{"word":"rain","partOfSpeech":"noun","definition":"מים שיורדים מהשמיים","example":"I look at the rain.","translation":"גשם"}],"questions":[{"question":"What is the weather today?","questionHe":"מה מזג האוויר היום?","options":["Hot","Very cold","Warm","Windy"],"optionsHe":["חם","מאוד קר","חמים","סוער"],"correctIndex":1,"explanation":"כתוב 'Today it is very cold'."},{"question":"Who makes the tea?","questionHe":"מי מכינה את התה?","options":["The mother","The sister","The father","The writer"],"optionsHe":["האמא","האחות","האבא","הכותב"],"correctIndex":1,"explanation":"כתוב 'My sister makes hot tea'."}]},{"title":"My New Shoes (הנעליים החדשות שלי)","text":"My mother buys me new shoes. They are blue and very nice. I wear them to school. My friend says they are good shoes.","textHe":"אמא שלי קונה לי נעליים חדשות. הן כחולות ומאוד יפות. אני נועל אותן לבית הספר. החבר שלי אומר שאלה נעליים טובות.","glossary":[{"word":"buy","partOfSpeech":"verb","definition":"לתת כסף ולקבל מוצר","example":"I buy bread.","translation":"לקנות"},{"word":"blue","partOfSpeech":"adjective","definition":"בצבע של השמיים","example":"The shoes are blue.","translation":"כחול"},{"word":"school","partOfSpeech":"noun","definition":"מקום שבו לומדים","example":"I go to school.","translation":"בית ספר"}],"questions":[{"question":"What colour are the shoes?","questionHe":"באיזה צבע הנעליים?","options":["Red","Blue","Black","White"],"optionsHe":["אדום","כחול","שחור","לבן"],"correctIndex":1,"explanation":"כתוב 'They are blue'."},{"question":"Where does the writer wear them?","questionHe":"לאן הכותב נועל אותן?","options":["To work","To school","To the park","To a party"],"optionsHe":["לעבודה","לבית הספר","לפארק","למסיבה"],"correctIndex":1,"explanation":"כתוב 'I wear them to school'."}]},{"title":"Dinner at Home (ארוחת ערב בבית)","text":"In the evening my family eats dinner together. My father makes soup and bread. We talk about our day. After dinner I wash the plates.","textHe":"בערב המשפחה שלי אוכלת ארוחת ערב ביחד. אבא שלי מכין מרק ולחם. אנחנו מדברים על היום שלנו. אחרי הארוחה אני שוטף את הצלחות.","glossary":[{"word":"dinner","partOfSpeech":"noun","definition":"הארוחה של הערב","example":"We eat dinner at seven.","translation":"ארוחת ערב"},{"word":"soup","partOfSpeech":"noun","definition":"מאכל נוזלי וחם","example":"The soup is hot.","translation":"מרק"},{"word":"plate","partOfSpeech":"noun","definition":"כלי שאוכלים ממנו","example":"I wash the plates.","translation":"צלחת"}],"questions":[{"question":"Who makes the soup?","questionHe":"מי מכין את המרק?","options":["The mother","The father","The sister","The writer"],"optionsHe":["האמא","האבא","האחות","הכותב"],"correctIndex":1,"explanation":"כתוב 'My father makes soup'."},{"question":"What happens after dinner?","questionHe":"מה קורה אחרי ארוחת הערב?","options":["They sleep","The writer washes the plates","They go out","They cook again"],"optionsHe":["הם הולכים לישון","הכותב שוטף את הצלחות","הם יוצאים","הם מבשלים שוב"],"correctIndex":1,"explanation":"כתוב 'I wash the plates'."}]}]