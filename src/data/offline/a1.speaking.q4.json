 program.","translation":"אני צופה בתוכנית האהובה עליי."}]},{"prompts":[{"text":"Can I ask a question?","translation":"אפשר לשאול שאלה?"},{"text":"Come here quickly!","translation":"בוא לכאן מהר!"},{"text":"It is a rainy day.","translation":"זה יום גשום."},{"text":"My sister is a fast reader.","translation":"אחותי קוראת מהר."}]},{"prompts":[{"text":"The reporter talks to the players.","translation":"הכתב מדבר עם השחקנים."},{"text":"We have a review before the test.","translation":"יש לנו חזרה לפני המבחן."},{"text":"She has a red ribbon in her hair.","translation":"יש לה סרט אדום בשיער."},{"text":"He has a big role in the play.","translation":"יש לו תפקיד גדול בהצגה."}]},{"prompts":[{"text":"I sit in the first row.","translation":"אני יושב בשורה הראשונה."},{"text":"Do you know the rules of the game?","translation":"אתה מכיר את חוקי המשחק?"},{"text":"Use a ruler to draw a line.","translation":"תשתמש בסרגל כדי למתוח קו."},{"text":"The sailor works on a big ship.","translation":"המלח עובד על ספינה גדולה."}]},{"prompts":[{"text":"We are in the same class.","translation":"אנחנו באותה כיתה."},{"text":"Say hello to your mom.","translation":"תגיד שלום לאמא שלך."},{"text":"I like science class.","translation":"אני אוהב את שיעור המדעים."},{"text":"The scientist has a new idea.","translation":"למדענית יש רעיון חדש."}]},{"prompts":[{"text":"Write a sentence with this word.","translation":"תכתוב משפט עם המילה הזאת."},{"text":"School starts in September.","translation":"הלימודים מתחילים בספטמבר."},{"text":"The books are on the shelf.","translation":"הספרים על המדף."},{"text":"My little brother is short.","translation":"אחי הקטן נמוך."}]},{"prompts":[{"text":"I take a shower every morning.","translation":"אני מתקלח כל בוקר."},{"text":"The shop is on the other side of the street.","translation":"החנות בצד השני של הרחוב."},{"text":"The sign says \"Stop\".","translation":"על השלט כתוב \"עצור\"."},{"text":"She is my favorite singer.","translation":"היא הזמרת האהובה עליי."}]},{"prompts"