[{"prompts":[{"text":"Sorry, I am late.","translation":"סליחה, אני מאחר."},{"text":"See you later!","translation":"נתראה אחר כך!"},{"text":"My cat is lazy.","translation":"החתול שלי עצלן."},{"text":"Noa is the leader of our group.","translation":"נועה היא המנהיגה של הקבוצה שלנו."}]},{"prompts":[{"text":"I leave home at seven.","translation":"אני יוצא מהבית בשבע."},{"text":"I write with my left hand.","translation":"אני כותב ביד שמאל."},{"text":"The English lesson is fun.","translation":"השיעור באנגלית כיפי."},{"text":"Let me help you.","translation":"תן לי לעזור לך."}]},{"prompts":[{"text":"Draw a line under the word.","translation":"תמתח קו מתחת למילה."},{"text":"Mom writes a shopping list.","translation":"אמא כותבת רשימת קניות."},{"text":"I live in Tel Aviv.","translation":"אני גר בתל אביב."},{"text":"The TV is in the living room.","translation":"הטלוויזיה בסלון."}]},{"prompts":[{"text":"She has long hair.","translation":"יש לה שיער ארוך."},{"text":"What a lovely day!","translation":"איזה יום נהדר!"},{"text":"Good luck on your test!","translation":"בהצלחה במבחן!"},{"text":"The washing machine is new.","translation":"מכונת הכביסה חדשה."}]},{"prompts":[{"text":"Spring begins in March.","translation":"האביב מתחיל במרץ."},{"text":"Math is my favorite subject.","translation":"מתמטיקה היא המקצוע האהוב עליי."},{"text":"The weather is nice in May.","translation":"מזג האוויר נעים במאי."},{"text":"Breakfast is the first meal of the day.","translation":"ארוחת בוקר היא הארוחה הראשונה של היום."}]},{"prompts":[{"text":"Nice to meet you!","translation":"נעים להכיר!"},{"text":"Dad has a meeting at ten.","translation":"לאבא יש פגישה בעשר."},{"text":"I have a happy memory of that day.","translation":"יש לי זיכרון שמח מהיום ההוא."},{"text":"I send a message to my friend.","translation":"אני שולח הודעה לחבר שלי."}]},{"prompts":[{"text":"My mobile phone is in my bag.","translation":"הטלפון הנייד שלי בתיק."},{"text":"My mom is a nurse.","translation":"אמא שלי אחות."},{"text":"Wait a moment, please.","translation":"חכה רגע, בבקשה."},{"text":"Let's watch a movie tonight.","translation":"בוא נראה סרט הערב."}]},{"prompts":[{"text":"What is your nationality?","translation":"מה האזרחות שלך?"},{"text":"Please don't make noise.","translation":"בבקשה אל תעשו רעש."},{"text":"I leave a note on the table.","translation":"אני משאיר פתק על השולחן."},{"text":"Write the date in your notebook.","translation":"תכתוב את התאריך במחברת שלך."}]},{"prompts":[{"text":"My sister was born in October.","translation":"אחותי נולדה באוקטובר."},{"text":"The police officer helps us.","translation":"השוטר עוזר לנו."},{"text":"I go swimming once a week.","translation":"אני הולך לשחות פעם בשבוע."},{"text":"I have only one brother.","translation":"יש לי רק אח אחד."}]},{"prompts":[{"text":"Open your books to page ten.","translation":"תפתחו את הספרים בעמוד עשר."},{"text":"I need a new pair of shoes.","translation":"אני צריך זוג נעליים חדש."},{"text":"The queen lives in a palace.","translation":"המלכה גרה בארמון."},{"text":"These pants are too long.","translation":"המכנסיים האלה ארוכים מדי."}]},{"prompts":[{"text":"My parents work in Jerusalem.","translation":"ההורים שלי עובדים בירושלים."},{"text":"Work with a partner.","translation":"תעבדו עם בן זוג."},{"text":"Come to my birthday party!","translation":"בוא למסיבת יום ההולדת שלי!"},{"text":"In the past, people wrote letters.","translation":"בעבר אנשים כתבו מכתבים."}]},{"prompts":[{"text":"Many people live in this city.","translation":"הרבה אנשים גרים בעיר הזאת."},{"text":"We have math in the first period.","translation":"יש לנו מתמטיקה בשיעור הראשון."},{"text":"She is a kind person.","translation":"היא אדם טוב לב."},{"text":"This is my personal diary.","translation":"זה היומן האישי שלי."}]},{"prompts":[{"text":"My sister plays the piano.","translation":"אחותי מנגנת בפסנתר."},{"text":"We have a picnic in the park.","translation":"אנחנו עושים פיקניק בפארק."},{"text":"Can I have a piece of cake?","translation":"אפשר לקבל חתיכת עוגה?"},{"text":"The plane lands at five.","translation":"המטוס נוחת בחמש."}]},{"prompts":[{"text":"It is a pleasure to help you.","translation":"זה תענוג לעזור לך."},{"text":"The keys are in my pocket.","translation":"המפתחות בכיס שלי."},{"text":"We read a poem in class.","translation":"קראנו שיר בכיתה."},{"text":"Our team has ten points.","translation":"לקבוצה שלנו יש עשר נקודות."}]},{"prompts":[{"text":"I have a poster on my wall.","translation":"יש לי פוסטר על הקיר."},{"text":"I have football practice today.","translation":"יש לי אימון כדורגל היום."},{"text":"People pray in the synagogue.","translation":"אנשים מתפללים בבית הכנסת."},{"text":"Thank you for the present!","translation":"תודה על המתנה!"}]},{"prompts":[{"text":"The prince rides a white horse.","translation":"הנסיך רוכב על סוס לבן."},{"text":"The princess lives in a castle.","translation":"הנסיכה גרה בטירה."},{"text":"I watch my favorite program.","translation":"אני צופה בתוכנית האהובה עליי."},{"text":"It is a quarter past six.","translation":"השעה שש ורבע."}]},{"prompts":[{"text":"Come here quickly!","translation":"בוא לכאן מהר!"},{"text":"It is a rainy day.","translation":"זה יום גשום."},{"text":"My sister is a fast reader.","translation":"אחותי קוראת מהר."},{"text":"I really like this song.","translation":"אני באמת אוהב את השיר הזה."}]},{"prompts":[{"text":"We have a review before the test.","translation":"יש לנו חזרה לפני המבחן."},{"text":"She has a red ribbon in her hair.","translation":"יש לה סרט אדום בשיער."},{"text":"He has a big role in the play.","translation":"יש לו תפקיד גדול בהצגה."},{"text":"Dad gives Mom a red rose.","translation":"אבא נותן לאמא ורד אדום."}]},{"prompts":[{"text":"Do you know the rules of the game?","translation":"אתה מכיר את חוקי המשחק?"},{"text":"Use a ruler to draw a line.","translation":"תשתמש בסרגל כדי למתוח קו."},{"text":"The sailor works on a big ship.","translation":"המלח עובד על ספינה גדולה."},{"text":"The shoes are on sale.","translation":"הנעליים במבצע."}]},{"prompts":[