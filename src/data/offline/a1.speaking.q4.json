"prompts":[{"text":"A birthday gift.","translation":"מתנת יום הולדת."},{"text":"We ate rice and chicken.","translation":"אכלנו אורז ועוף."},{"text":"A cup of tea.","translation":"כוס תה."},{"text":"Eat with a spoon.","translation":"אכול בכפית."}]},{"prompts":[{"text":"A cup of tea.","translation":"כוס תה."},{"text":"Put it on the plate.","translation":"שים את זה על הצלחת."},{"text":"A bowl of soup.","translation":"קערת מרק."},{"text":"I eat a banana.","translation":"אני אוכל בננה."}]},{"prompts":[{"text":"Boiled potatoes.","translation":"תפוחי אדמה מבושלים."},{"text":"We ate chicken.","translation":"אכלנו עוף."},{"text":"I don't eat meat.","translation":"אני לא אוכל בשר."},{"text":"Orange juice.","translation":"מיץ תפוזים."}]},{"prompts":[{"text":"Add some salt.","translation":"תוסיף קצת מלח."},{"text":"A blue dress.","translation":"שמלה כחולה."},{"text":"Wear your coat.","translation":"לבש את המעיל."},{"text":"A pair of socks.","translation":"זוג גרביים."}]},{"prompts":[{"text":"A grey cloud.","translation":"ענן אפור."},{"text":"A cold wind.","translation":"רוח קרה."},{"text":"The snow is white.","translation":"השלג לבן."},{"text":"I'm going home.","translation":"אני הולך הביתה."}]},{"prompts":[{"text":"We swam in the lake.","translation":"שחינו באגם."},{"text":"A green hill.","translation":"גבעה ירוקה."},{"text":"Today is Monday.","translation":"היום יום שני."},{"text":"See you tomorrow.","translation":"נתראה מחר."}]},{"prompts":[{"text":"Last year was hard.","translation":"השנה שעברה הייתה קשה."},{"text":"Wait a minute.","translation":"חכה דקה."},{"text":"We swim in summer.","translation":"אנחנו שוחים בקיץ."},{"text":"Flowers grow in spring.","translation":"פרחים צומחים באביב."}]},{"prompts":[{"text":"The first day.","translation":"היום הראשון."},{"text":"The last bus.","translation":"האוטובוס האחרון."},{"text":"The next train.","translation":"הרכבת הבאה."},{"text":"Come here.","translation":"בוא לכאן."}]},{"prompts":[{"text":"Do it now.","translation":"עשה את זה עכשיו."},{"text":"Try again.","translation":"נסה שוב."},{"text":"It's very hot.","translation":"זה מאוד חם."},{"text":"I also like tea.","translation":"גם אני אוהב תה."}]},{"prompts":[{"text":"Maybe later.","translation":"אולי אחר כך."},{"text":"Hello, how are you?","translation":"שלום, מה שלומך?"},{"text":"Goodbye, see you!","translation":"להתראות, נתראה!"},{"text":"Sorry, I'm late.","translation":"סליחה, אני מאחר."}]},{"prompts":[{"text":"Welcome home!","translation":"ברוך הבא הביתה!"},{"text":"He wore black trousers.","translation":"הוא לבש מכנסיים שחורים."},{"text":"Put on your jacket.","translation":"שים את הז'קט."},{"text":"A long skirt.","translation":"חצאית ארוכה."}]},{"prompts":[{"text":"A red scarf.","translation":"צעיף אדום."},{"text":"Winter boots.","translation":"מגפי חורף."},{"text":"Bread and cheese.","translation":"לחם וגבינה."},{"text":"Butter on toast.","translation":"חמאה על טוסט."}]}]