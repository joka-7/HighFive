[{"prompts":[{"text":"Good morning! How are you?","translation":"בוקר טוב! מה שלומך?"},{"text":"My name is Maya and I live in Tel Aviv.","translation":"שמי מאיה ואני גרה בתל אביב."},{"text":"I would like a cup of coffee, please.","translation":"אני רוצה כוס קפה, בבקשה."},{"text":"Where is the train station?","translation":"איפה תחנת הרכבת?"}]},{"prompts":[{"text":"This is my family. I have two brothers.","translation":"זאת המשפחה שלי. יש לי שני אחים."},{"text":"I am happy to meet you.","translation":"אני שמח להכיר אותך."},{"text":"What time is it now?","translation":"מה השעה עכשיו?"},{"text":"I go to school every day.","translation":"אני הולך לבית הספר כל יום."}]},{"prompts":[{"text":"The weather is nice today.","translation":"מזג האוויר נעים היום."},{"text":"How much is this, please?","translation":"כמה זה עולה, בבקשה?"},{"text":"I have a small dog at home.","translation":"יש לי כלב קטן בבית."},{"text":"Thank you very much. Goodbye!","translation":"תודה רבה. להתראות!"}]},{"prompts":[{"text":"I have a brother and a sister.","translation":"יש לי אח ואחות."},{"text":"Can I have some water, please?","translation":"אפשר קצת מים, בבקשה?"},{"text":"I don't understand. Can you help me?","translation":"אני לא מבין. תוכל לעזור לי?"},{"text":"My favourite colour is blue.","translation":"הצבע האהוב עליי הוא כחול."}]},{"prompts":[{"text":"See you tomorrow!","translation":"נתראה מחר!"},{"text":"I am a little tired today.","translation":"אני קצת עייף היום."},{"text":"Excuse me, where is the toilet?","translation":"סליחה, איפה השירותים?"},{"text":"I am hungry. Let's eat.","translation":"אני רעב. בוא נאכל."}]},{"prompts":[{"text":"What is this in English?","translation":"איך אומרים את זה באנגלית?"},{"text":"It is very cold today.","translation":"קר מאוד היום."},{"text":"I would like some bread, please.","translation":"אני רוצה קצת לחם, בבקשה."},{"text":"My favourite animal is a dog.","translation":"החיה האהובה עליי היא כלב."}]},{"prompts":[{"text":"It is snowing outside.","translation":"יורד שלג בחוץ."},{"text":"Can I sit here?","translation":"אפשר לשבת כאן?"},{"text":"I live near the park.","translation":"אני גר ליד הפארק."},{"text":"Can you say that again, please?","translation":"תוכל לומר את זה שוב, בבקשה?"}]},{"prompts":[{"text":"See you tomorrow morning.","translation":"נתראה מחר בבוקר."},{"text":"I have a little brother.","translation":"יש לי אח קטן."},{"text":"Where is the bathroom, please?","translation":"איפה השירותים, בבקשה?"},{"text":"I like cheese and bread.","translation":"אני אוהב גבינה ולחם."}]},{"prompts":[{"text":"I am hungry. Can we eat?","translation":"אני רעב. אפשר לאכול?"},{"text":"My favourite colour is blue.","translation":"הצבע האהוב עליי הוא כחול."},{"text":"Please open the window.","translation":"בבקשה תפתח את החלון."},{"text":"This is my school bag.","translation":"זה התיק שלי."}]},{"prompts":[{"text":"I want to play outside.","translation":"אני רוצה לשחק בחוץ."},{"text":"Good night, see you tomorrow.","translation":"לילה טוב, נתראה מחר."},{"text":"I have breakfast at seven.","translation":"אני אוכל ארוחת בוקר בשבע."},{"text":"The market is near my house.","translation":"השוק ליד הבית שלי."}]}]